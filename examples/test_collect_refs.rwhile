(* test_collect_refs.rwhile — fast reversibility harness for COLLECT-REFS (案1-B).
 * WRITES-ONLY version: collect K only where ('var.K) is in a WRITE position
 * ('ass target, 'rep write-pattern), not in read expressions/patterns.  This is
 * the precise assigned-set (over-approx caused spurious dynamicization -> 'lcheck
 * '41 in comp2).  Scan only commands ('seq/'ass/'rep/'cond/'loop) and write
 * patterns ('cons/'var/'val); SKIP children (read exprs/pats) ride in the begin
 * marker (not scanned, preserved whole).  Grammar-directed, reversible via case +
 * begin/end markers (as PAT-READ-ITER).  Tree preserved.  Test: forward then INV;
 * out == in + no error iff reversible.  Iterate via ./ri before porting. *)

macro COLLECT-REFS-STEP(CrWk, CrWk2, CrRefs)
  cons CrN CrWk <= CrWk;
  case CrN yields CrN of
      cons 'var CrK =>
        CrKc ^= CrK; CrRefs <= cons CrKc CrRefs
        => cons 'var CrK
    | cons 'val CrV =>
        CrNop ^= nil; CrNop ^= nil
        => cons 'val CrV
    | cons 'cons CrAg =>
        cons CrX CrY <= CrAg;
        CrWk <= cons CrX (cons CrY (cons ('consE . nil) CrWk));
        CrX ^= CrX; CrY ^= CrY
        => cons 'consB CrAg
    | cons 'consE CrZ =>
        cons CrY (cons CrX (cons ('consB . nil) CrWk2)) <= CrWk2;
        CrAg2 <= cons CrX CrY
        => cons 'cons CrAg2
    | cons 'seq CrAgS =>
        cons CrS1 CrS2 <= CrAgS;
        CrWk <= cons CrS1 (cons CrS2 (cons ('seqE . nil) CrWk));
        CrS1 ^= CrS1; CrS2 ^= CrS2
        => cons 'seqB CrAgS
    | cons 'seqE CrZs =>
        cons CrS2b (cons CrS1b (cons ('seqB . nil) CrWk2)) <= CrWk2;
        CrAgS2 <= cons CrS1b CrS2b
        => cons 'seq CrAgS2
    | cons 'ass CrAgA =>
        cons CrAt CrAe <= CrAgA;
        CrWk <= cons CrAt (cons ('assE . nil) CrWk);
        CrAt ^= CrAt
        => cons 'assB CrAe
    | cons 'assE CrZa =>
        cons CrAt2 (cons (cons 'assB CrAe2) CrWk2) <= CrWk2;
        CrAgA2 <= cons CrAt2 CrAe2
        => cons 'ass CrAgA2
    | cons 'rep CrAgR =>
        cons CrR1 CrR2 <= CrAgR;
        CrWk <= cons CrR1 (cons ('repE . nil) CrWk);
        CrR1 ^= CrR1
        => cons 'repB CrR2
    | cons 'repE CrZr =>
        cons CrR1b (cons (cons 'repB CrR2b) CrWk2) <= CrWk2;
        CrAgR2 <= cons CrR1b CrR2b
        => cons 'rep CrAgR2
    | cons 'cond CrAgC =>
        cons CrCe (cons CrCc (cons CrCd (cons CrCf nil))) <= CrAgC;
        CrWk <= cons CrCc (cons CrCd (cons ('condE . nil) CrWk));
        CrCc ^= CrCc; CrCd ^= CrCd
        => cons 'condB (cons CrCe CrCf)
    | cons 'condE CrZc =>
        cons CrCd2 (cons CrCc2 (cons (cons 'condB (cons CrCe2 CrCf2)) CrWk2)) <= CrWk2;
        CrAgC2 <= cons CrCe2 (cons CrCc2 (cons CrCd2 (cons CrCf2 nil)))
        => cons 'cond CrAgC2
    | cons 'loop CrAgL =>
        cons CrLe (cons CrLd (cons CrLl (cons CrLf nil))) <= CrAgL;
        CrWk <= cons CrLd (cons CrLl (cons ('loopE . nil) CrWk));
        CrLd ^= CrLd; CrLl ^= CrLl
        => cons 'loopB (cons CrLe CrLf)
    | cons 'loopE CrZl =>
        cons CrLl2 (cons CrLd2 (cons (cons 'loopB (cons CrLe2 CrLf2)) CrWk2)) <= CrWk2;
        CrAgL2 <= cons CrLe2 (cons CrLd2 (cons CrLl2 (cons CrLf2 nil)))
        => cons 'loop CrAgL2
    | Rest =>
        CrNop2 ^= nil; CrNop2 ^= nil
        => Rest
  end;
  CrWk2 <= cons CrN CrWk2

macro COLLECT-REFS(CrTree, CrRefs)
  CrWk <= cons CrTree nil;
  from (=? CrWk2 nil) loop
    COLLECT-REFS-STEP(CrWk, CrWk2, CrRefs)
  until (=? CrWk nil);
  cons CrTree nil <= CrWk2

read In;
  COLLECT-REFS(In, Refs);
  INV-COLLECT-REFS(In, Refs);
write In
