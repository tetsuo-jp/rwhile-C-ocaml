(*
 * spec_av.rwhile - WIP: AV-based (partially-static) specializer for R-WHILE.
 *
 * Developed in parallel with spec.rwhile (the working baseline) so the rewrite
 * to partially-static values does not break it.  See
 * analysis_partial_static_design.md.  This file currently contains:
 *   - the partial store ops (AUX / LOOKUP / UPDATE), same as spec.rwhile
 *   - the AV algebra (AV-CONS/HD/TL/LIFT/EQ), same as av.rwhile
 *   - SPEC-EXP-AV: an AV-based expression specializer (the step-2 deliverable)
 *
 * Annotated value (AV):
 *   ('S . v)            static value v
 *   ('D . code)         dynamic, residual expression code
 *   ('C . (av1 . av2))  partially-static cons
 * Store slot Vl[k] holds an AV (dynamic slots are ('D . ('var . k))).
 *)

(* ===== Partial store ops (identical to spec.rwhile) ===== *)

macro LOOKUP(Vl,J,X)
  AUX(Vl,J,Y);
  X ^= Y;
  INV-AUX(Vl,J,Y)

macro UPDATE(Vl,J,X)
  AUX(Vl,J,Y);
  Y ^= X;
  INV-AUX(Vl,J,Y)

macro AUX(Vl,J,X)
  from (=? JJ nil) loop
    cons U Vl <= Vl;
    Vr <= cons U Vr;
    JJ <= cons nil JJ
  until (=? JJ J);
  cons Y T <= Vl

(* ===== AV algebra (identical to av.rwhile) ===== *)

macro AV-HD(A, R)
  cons T V <= A;
  CT ^= =? T 'S;
  if =? T 'S then
    cons H Tl <= V;
    Tl ^= Tl;
    R <= cons 'S H;
    T ^= 'S
  else
    CC ^= =? T 'C;
    if =? T 'C then
      cons A1 A2 <= V;
      A2 ^= A2;
      R <= A1;
      T ^= 'C
    else
      R <= cons 'D (cons 'hd V);
      T ^= 'D
    fi CC;
    CC ^= CC
  fi CT;
  CT ^= CT

macro AV-TL(A, R)
  cons T V <= A;
  CT ^= =? T 'S;
  if =? T 'S then
    cons H Tl <= V;
    H ^= H;
    R <= cons 'S Tl;
    T ^= 'S
  else
    CC ^= =? T 'C;
    if =? T 'C then
      cons A1 A2 <= V;
      A1 ^= A1;
      R <= A2;
      T ^= 'C
    else
      R <= cons 'D (cons 'tl V);
      T ^= 'D
    fi CC;
    CC ^= CC
  fi CT;
  CT ^= CT

macro AV-CONS(A1, A2, R)
  cons T1 V1 <= A1;
  cons T2 V2 <= A2;
  S1 ^= =? T1 'S;
  S2 ^= =? T2 'S;
  Both ^= nil;
  if S1 then
    if S2 then Both ^= (nil.nil) fi S2
  fi S1;
  CBoth ^= Both;
  if Both then
    R <= cons 'S (cons V1 V2);
    T1 ^= 'S; T2 ^= 'S
  else
    A1 <= cons T1 V1;
    A2 <= cons T2 V2;
    R <= cons 'C (cons A1 A2)
  fi CBoth;
  CBoth ^= CBoth;
  Both ^= Both;
  S1 ^= S1;
  S2 ^= S2

macro AV-LIFT(A, Code)
  A <= cons A nil;
  from (=? A' nil) loop
    AV-LIFT-STEP(A, A', RSt)
  until (=? A nil);
  cons A nil <= A';
  cons Code nil <= RSt

macro AV-LIFT-STEP(Wk, Wk', RSt)
  cons (cons LfTag LfPay) Wk <= Wk;
  if =? LfTag 'S then
    LfPayC ^= LfPay;
    RSt <= cons (cons 'val LfPayC) RSt
  else
   if =? LfTag 'D then
     LfPayC ^= LfPay;
     RSt <= cons LfPayC RSt
   else
    if =? LfTag 'C then
      LfTag ^= 'C; LfTag ^= 'CB;
      cons LfX LfY <= LfPay;
      Wk <= cons LfX (cons LfY (cons ('CE . nil) Wk));
      LfX ^= LfX; LfY ^= LfY
    else
     if =? LfTag 'CE then
       LfTag ^= 'CE; LfTag ^= 'C;
       cons LfY (cons LfX (cons ('CB . nil) Wk')) <= Wk';
       LfPay <= cons LfX LfY;
       cons LfQ (cons LfP RSt) <= RSt;
       RSt <= cons (cons 'cons (cons LfP LfQ)) RSt
     else
       'error <= '9
     fi =? LfTag 'C
    fi =? LfTag 'CB
   fi =? LfTag 'D
  fi =? LfTag 'S;
  Wk' <= cons (cons LfTag LfPay) Wk'

(* AV-UNCONS(A, A1, A2): split a cons-shaped AV into its two components
 * ('C/'S-cons split; 'D symbolic). Used for partially-static pattern reads. *)
macro AV-UNCONS(A, A1, A2)
  cons T V <= A;
  CUs ^= =? T 'S;
  if =? T 'S then
    cons H Tl <= V;
    A1 <= cons 'S H;
    A2 <= cons 'S Tl;
    T ^= 'S
  else
    CUc ^= =? T 'C;
    if =? T 'C then
      cons A1 A2 <= V;
      T ^= 'C
    else
      Vc ^= V;
      A1 <= cons 'D (cons 'hd V);
      A2 <= cons 'D (cons 'tl Vc);
      T ^= 'D
    fi CUc;
    CUc ^= CUc
  fi CUs;
  CUs ^= CUs

macro AV-EQ(A1, A2, R)
  cons T1 V1 <= A1;
  cons T2 V2 <= A2;
  BothS ^= nil;
  if =? T1 'S then
    if =? T2 'S then BothS ^= (nil.nil) fi =? T2 'S
  fi =? T1 'S;
  CBothS ^= BothS;
  if BothS then
    EqRes ^= =? V1 V2;
    R <= cons 'S EqRes;
    V1 ^= V1; V2 ^= V2;
    T1 ^= 'S; T2 ^= 'S
  else
    A1 <= cons T1 V1;
    A2 <= cons T2 V2;
    AV-LIFT(A1, C1);
    AV-LIFT(A2, C2);
    A1 ^= A1; A2 ^= A2;
    R <= cons 'D (cons 'eq (cons C1 C2))
  fi CBothS;
  CBothS ^= CBothS;
  BothS ^= BothS

(* ===== AV-based expression specializer ===== *)

(* SPEC-EXP-AV(E, RE): RE := AV result of specializing expression E against the
 * AV store Vl.  E is preserved (shell reconstructed), like spec.rwhile's
 * SPEC-EXP. Stack machine: Cd = work stack, Cd' = done stack, RSt = AV results. *)
macro SPEC-EXP-AV(E, RE)
  E <= cons E nil;
  from (=? E' nil) loop
    SPEC-EXP-AV-STEP(E, E', RSt)
  until (=? E nil);
  cons E nil <= E';
  cons RE nil <= RSt

macro SPEC-EXP-AV-STEP(Cd, Cd', RSt)
  cons (cons ETag EArg) Cd <= Cd;
  if =? ETag 'var then
    (* variable: push its store AV (LOOKUP is non-destructive) *)
    LOOKUP(Vl, EArg, SX);
    RSt <= cons SX RSt
  else
   if =? ETag 'val then
     (* literal: static AV ('S . v) *)
     EArgCopy ^= EArg;
     RSt <= cons (cons 'S EArgCopy) RSt
   else
    if =? ETag 'cons then
      ETag ^= 'cons; ETag ^= 'consB;
      cons E1 E2 <= EArg;
      Cd <= cons E1 (cons E2 (cons ('consE . nil) Cd))
    else
     if =? ETag 'consE then
       ETag ^= 'consE; ETag ^= 'cons;
       cons E2 (cons E1 (cons ('consB . nil) Cd')) <= Cd';
       EArg <= cons E1 E2;
       cons R2 (cons R1 RSt) <= RSt;
       AV-CONS(R1, R2, Rc);
       RSt <= cons Rc RSt
     else
      if =? ETag 'hd then
        ETag ^= 'hd; ETag ^= 'hdB;
        Cd <= cons EArg (cons ('hdE . nil) Cd)
      else
       if =? ETag 'hdE then
         ETag ^= 'hdE; ETag ^= 'hd;
         cons EArg (cons ('hdB . nil) Cd') <= Cd';
         cons R1 RSt <= RSt;
         AV-HD(R1, Rh);
         RSt <= cons Rh RSt
       else
        if =? ETag 'tl then
          ETag ^= 'tl; ETag ^= 'tlB;
          Cd <= cons EArg (cons ('tlE . nil) Cd)
        else
         if =? ETag 'tlE then
           ETag ^= 'tlE; ETag ^= 'tl;
           cons EArg (cons ('tlB . nil) Cd') <= Cd';
           cons R1 RSt <= RSt;
           AV-TL(R1, Rt);
           RSt <= cons Rt RSt
         else
          if =? ETag 'eq then
            ETag ^= 'eq; ETag ^= 'eqB;
            cons E1 E2 <= EArg;
            Cd <= cons E1 (cons E2 (cons ('eqE . nil) Cd))
          else
           if =? ETag 'eqE then
             ETag ^= 'eqE; ETag ^= 'eq;
             cons E2 (cons E1 (cons ('eqB . nil) Cd')) <= Cd';
             EArg <= cons E1 E2;
             cons R2 (cons R1 RSt) <= RSt;
             AV-EQ(R1, R2, Re);
             RSt <= cons Re RSt
           else
             'error <= '0
           fi =? ETag 'eq
          fi =? ETag 'eqB
         fi =? ETag 'tl
        fi =? ETag 'tlB
       fi =? ETag 'hd
      fi =? ETag 'hdB
     fi =? ETag 'cons
    fi =? ETag 'consB
   fi =? ETag 'val
  fi =? ETag 'var;
  Cd' <= cons (cons ETag EArg) Cd'

(* ===== AV pattern helpers (for 'rep), ported from spec.rwhile =====
 * Store slots are AVs: static ('S.v), dynamic ('D.('var.k)).  These handle
 * 'var, 'val and one level of 'cons (the SIMPLE forms). *)

macro PAT-LEAF-STATIC-AV(PP, Stat)
  if =? (hd PP) 'var then
    cons PLStg PLSag <= PP;
    LOOKUP(Vl, PLSag, PLSsv);
    Stat ^= =? (hd PLSsv) 'S;
    PLSsv ^= PLSsv;
    PP <= cons PLStg PLSag
  else
    Stat ^= (nil.nil)
  fi =? (hd PP) 'var

macro CHECK-PAT-STATIC-AV(PP, Stat)
  if =? (hd PP) 'cons then
    cons CPStg CPSag <= PP;
    cons CPSp1 CPSp2 <= CPSag;
    PAT-LEAF-STATIC-AV(CPSp1, CPS1);
    PAT-LEAF-STATIC-AV(CPSp2, CPS2);
    if CPS1 then
      if CPS2 then Stat ^= (nil.nil) fi CPS2
    fi CPS1;
    CPS1 ^= CPS1;
    CPS2 ^= CPS2;
    CPSag <= cons CPSp1 CPSp2;
    PP <= cons CPStg CPSag
  else
    PAT-LEAF-STATIC-AV(PP, Stat)
  fi =? (hd PP) 'cons

(* PAT-READ-LEAF-AV: read a static leaf value into PV; set 'var slot to dynamic. *)
macro PAT-READ-LEAF-AV(PP, PV)
  if =? (hd PP) 'var then
    cons PRLtg PRLag <= PP;
    LOOKUP(Vl, PRLag, PRLsv);     (* PRLsv = ('S . v) *)
    PV ^= tl PRLsv;               (* PV = v *)
    UPDATE(Vl, PRLag, PRLsv);     (* clear slot to nil *)
    PRLsv ^= PRLsv;               (* discard old AV *)
    PRLagc ^= PRLag;
    PRLsv <= cons 'D (cons 'var PRLagc);
    UPDATE(Vl, PRLag, PRLsv);     (* slot = ('D.('var.k))  (PRLsv preserved) *)
    cons PRLdd PRLdr <= PRLsv; PRLdd ^= PRLdd; PRLdr ^= PRLdr;
    PP <= cons PRLtg PRLag
  else
    PV ^= tl PP
  fi =? (hd PP) 'var

macro PAT-READ-SIMPLE-AV(PP, PV)
  if =? (hd PP) 'cons then
    cons PRStg PRSag <= PP;
    cons PRSp1 PRSp2 <= PRSag;
    PAT-READ-LEAF-AV(PRSp1, PRSv1);
    PAT-READ-LEAF-AV(PRSp2, PRSv2);
    PV <= cons PRSv1 PRSv2;
    PRSag <= cons PRSp1 PRSp2;
    PP <= cons PRStg PRSag
  else
    PAT-READ-LEAF-AV(PP, PV)
  fi =? (hd PP) 'cons

(* PAT-WRITE-LEAF-AV: write static value PV into 'var slot as ('S.PV); 'dynamic
 * marker sets the slot dynamic instead. *)
macro PAT-WRITE-LEAF-AV(PP, PV)
  if =? (hd PP) 'var then
    cons PWLtg PWLag <= PP;
    LOOKUP(Vl, PWLag, PWLsv);
    UPDATE(Vl, PWLag, PWLsv);     (* clear slot to nil *)
    PWLsv ^= PWLsv;
    IsDyn ^= =? PV 'dynamic;
    if IsDyn then
      PWLagc ^= PWLag;
      PWLsv <= cons 'D (cons 'var PWLagc);
      UPDATE(Vl, PWLag, PWLsv);
      cons PWLdd PWLdr <= PWLsv; PWLdd ^= PWLdd; PWLdr ^= PWLdr;
      PV ^= 'dynamic
    else
      PWLsv <= cons 'S PV;        (* slot = ('S . PV) *)
      UPDATE(Vl, PWLag, PWLsv);
      cons PWLss PWLsval <= PWLsv; PWLss ^= PWLss; PWLsval ^= PWLsval
    fi IsDyn;
    IsDyn ^= IsDyn;
    PP <= cons PWLtg PWLag
  else
    PV ^= PV
  fi =? (hd PP) 'var

macro PAT-WRITE-SIMPLE-AV(PP, PV)
  if =? (hd PP) 'cons then
    cons PWStg PWSag <= PP;
    cons PWSp1 PWSp2 <= PWSag;
    cons PWSv1 PWSv2 <= PV;
    PAT-WRITE-LEAF-AV(PWSp1, PWSv1);
    PAT-WRITE-LEAF-AV(PWSp2, PWSv2);
    PWSag <= cons PWSp1 PWSp2;
    PP <= cons PWStg PWSag
  else
    PAT-WRITE-LEAF-AV(PP, PV)
  fi =? (hd PP) 'cons

macro PAT-CLR-LEAF-AV(PP)
  if =? (hd PP) 'var then
    cons PCLtg PCLag <= PP;
    LOOKUP(Vl, PCLag, PCLsv);
    UPDATE(Vl, PCLag, PCLsv);
    PCLsv ^= PCLsv;
    PCLagc ^= PCLag;
    PCLsv <= cons 'D (cons 'var PCLagc);
    UPDATE(Vl, PCLag, PCLsv);
    cons PCLdd PCLdr <= PCLsv; PCLdd ^= PCLdd; PCLdr ^= PCLdr;
    PP <= cons PCLtg PCLag
  fi =? (hd PP) 'var

macro PAT-CLR-SIMPLE-AV(PP)
  if =? (hd PP) 'cons then
    cons PCStg PCSag <= PP;
    cons PCSp1 PCSp2 <= PCSag;
    PAT-CLR-LEAF-AV(PCSp1);
    PAT-CLR-LEAF-AV(PCSp2);
    PCSag <= cons PCSp1 PCSp2;
    PP <= cons PCStg PCSag
  else
    PAT-CLR-LEAF-AV(PP)
  fi =? (hd PP) 'cons

(* ===== AV-aware pattern read/write (for partially-static 'rep) =====
 * Read a pattern into an AV (consuming its vars); write an AV into a pattern.
 * cons patterns split/combine via AV-CONS / AV-UNCONS, so partially-static
 * structures (e.g. (prog.data)) are handled without losing the static part. *)

macro PAT-READ-LEAF-AV2(P, RA)
  if =? (hd P) 'var then
    cons PRLt PRLi <= P;
    LOOKUP(Vl, PRLi, PRLs);     (* PRLs = current slot AV *)
    RA ^= PRLs;                 (* RA = slot AV (PRLs preserved) *)
    UPDATE(Vl, PRLi, PRLs);     (* slot ^= PRLs -> nil *)
    PRLs ^= PRLs;               (* discard old slot AV *)
    PRLs <= cons 'S nil;        (* consumed var becomes static nil *)
    UPDATE(Vl, PRLi, PRLs);     (* slot = ('S.nil) *)
    cons PRLss PRLsv <= PRLs; PRLss ^= PRLss; PRLsv ^= PRLsv;
    P <= cons PRLt PRLi
  else
    PRLv ^= tl P;
    RA <= cons 'S PRLv
  fi =? (hd P) 'var

macro PAT-READ-AV(P, RA)
  if =? (hd P) 'cons then
    cons PRtg PRag <= P;
    cons PRp1 PRp2 <= PRag;
    PAT-READ-LEAF-AV2(PRp1, PRa1);
    PAT-READ-LEAF-AV2(PRp2, PRa2);
    AV-CONS(PRa1, PRa2, RA);
    PRag <= cons PRp1 PRp2;
    P <= cons PRtg PRag
  else
    PAT-READ-LEAF-AV2(P, RA)
  fi =? (hd P) 'cons

macro PAT-WRITE-LEAF-AV2(P, WA)
  if =? (hd P) 'var then
    cons PWLt PWLi <= P;
    LOOKUP(Vl, PWLi, PWLs);
    UPDATE(Vl, PWLi, PWLs);     (* clear slot to nil *)
    PWLs ^= PWLs;               (* discard old *)
    PWLs <= WA;                 (* move WA into PWLs (WA consumed) *)
    UPDATE(Vl, PWLi, PWLs);     (* slot = WA (PWLs preserved) *)
    cons PWLss PWLsv <= PWLs; PWLss ^= PWLss; PWLsv ^= PWLsv;
    P <= cons PWLt PWLi
  else
    WA ^= WA
  fi =? (hd P) 'var

macro PAT-WRITE-AV(P, WA)
  if =? (hd P) 'cons then
    cons PWtg PWag <= P;
    cons PWp1 PWp2 <= PWag;
    AV-UNCONS(WA, PWa1, PWa2);
    PAT-WRITE-LEAF-AV2(PWp1, PWa1);
    PAT-WRITE-LEAF-AV2(PWp2, PWa2);
    PWag <= cons PWp1 PWp2;
    P <= cons PWtg PWag
  else
    PAT-WRITE-LEAF-AV2(P, WA)
  fi =? (hd P) 'cons

(* ===== AV-based command specializer (WIP: 'seq and 'ass) =====
 * SPEC-STEP-AV processes one command; residual commands accumulate in RCode
 * (reverse order).  Store slots are AVs; a dynamic slot is ('D.('var.k)). *)
macro SPEC-STEP-AV(Cd, Cd', RCode)
  cons (cons Tag Arg) Cd <= Cd;
  if =? Tag 'ass then
    cons (cons 'var K) E <= Arg;
    SPEC-EXP-AV(E, RE);
    cons TRE VRE <= RE;            (* RE -> TRE, VRE  (RE = nil) *)
    ExpS ^= =? TRE 'S;
    if ExpS then
      (* static expression value VRE *)
      LOOKUP(Vl, K, AVx);
      UPDATE(Vl, K, AVx);          (* AVx = old slot; slot = nil *)
      cons TAVx VAVx <= AVx;       (* AVx -> TAVx, VAVx  (AVx = nil) *)
      if =? TAVx 'S then
        (* static variable: reversible update of VAVx with VRE *)
        NewV ^= VRE;
        CKNil ^= =? VAVx nil;
        if =? VAVx nil then
          VAVx ^= NewV
        else
          CKNew ^= =? VAVx NewV;
          if =? VAVx NewV then
            VAVx ^= NewV; VAVx ^= nil; NewV ^= VRE
          else
            if =? NewV nil then NewV ^= VRE else 'error <= '10 fi =? NewV VRE
          fi CKNew;
          CKNew ^= CKNew
        fi CKNil;
        CKNil ^= CKNil;
        NewV ^= NewV;
        AVx <= cons TAVx VAVx;     (* reassemble ('S . VAVx') *)
        UPDATE(Vl, K, AVx)         (* slot = new AV  (AVx preserved) *)
      else
        (* dynamic/partial variable, static expr: restore slot, residualize *)
        AVx <= cons TAVx VAVx;
        UPDATE(Vl, K, AVx);        (* slot unchanged  (AVx preserved) *)
        KK ^= K;
        VREc ^= VRE;
        RCode <= cons (cons 'ass (cons (cons 'var KK) (cons 'val VREc))) RCode
      fi =? (hd AVx) 'S;
      cons TAVx VAVx <= AVx;       (* re-split AVx -> clear  (AVx = nil) *)
      TAVx ^= TAVx; VAVx ^= VAVx;
      VRE ^= VRE;
      TRE ^= 'S
    else
      (* dynamic or partial expr: residualize X ^= lift(RE); slot -> dynamic *)
      RE <= cons TRE VRE;          (* reassemble RE *)
      AV-LIFT(RE, LE);             (* AV-LIFT preserves RE *)
      RE ^= RE;
      LOOKUP(Vl, K, AVx);
      UPDATE(Vl, K, AVx);          (* slot = nil; AVx = old *)
      AVx ^= AVx;                  (* discard old AV *)
      KKc ^= K;
      AVx <= cons 'D (cons 'var KKc);
      UPDATE(Vl, K, AVx);          (* slot = ('D.('var.K))  (AVx preserved) *)
      cons TD AVxR <= AVx;         (* re-split -> clear AVx *)
      TD ^= TD; AVxR ^= AVxR;
      KK ^= K;
      RCode <= cons (cons 'ass (cons (cons 'var KK) LE)) RCode
    fi ExpS;
    ExpS ^= ExpS;
    Arg <= cons (cons 'var K) E
  else
   if =? Tag 'rep then
     (* Execute the replacement in the AV domain: read R as an AV, write it into
      * Q.  cons patterns split/combine via AV-UNCONS / AV-CONS, so a partially-
      * static structure (e.g. (prog.data)) is split without losing the static
      * part, and a fully-dynamic value flows symbolically (lifted at output). *)
     cons RpQ RpR <= Arg;
     PAT-READ-AV(RpR, RpAV);
     PAT-WRITE-AV(RpQ, RpAV);
     Arg <= cons RpQ RpR
   else
    if =? Tag 'cond then
      cons E (cons C (cons D (cons F nil))) <= Arg;   (* Arg -> E,C,D,F *)
      SPEC-EXP-AV(E, RE);                              (* E preserved; RE = test AV *)
      cons TT VT <= RE;
      AnnT ^= =? TT 'S;
      if AnnT then
        (* static test: VT is the boolean; take one branch, drop the other *)
        CVT ^= VT;
        if VT then
          Cd <= cons C Cd;
          D ^= D
        else
          Cd <= cons D Cd;
          C ^= C
        fi CVT;
        CVT ^= CVT;
        VT ^= VT; TT ^= 'S;
        E ^= E; F ^= F
      else
        (* dynamic test: residualize the whole conditional with lifted test *)
        RE <= cons TT VT;
        AV-LIFT(RE, LE);
        RE ^= RE;
        E ^= E;
        Arg <= cons LE (cons C (cons D (cons F nil)));
        Ccond ^= Arg;
        RCode <= cons (cons 'cond Ccond) RCode;
        Arg ^= Arg
      fi AnnT;
      AnnT ^= AnnT
    else
     if =? Tag 'loop then
       (* loop = ('loop . (E . (D . (L . (F . nil))))).  Static control unrolls
        * via an 'lcheck continuation; dynamic control residualizes the loop. *)
       cons LpE (cons LpD (cons LpL (cons LpF nil))) <= Arg;
       SPEC-EXP-AV(LpE, LpRE);
       cons LpTE LpVE <= LpRE;
       LpCEs ^= =? LpTE 'S;
       if LpCEs then
         if LpVE then
           (* static entry true: run D, then check exit via 'lcheck *)
           LpEc ^= LpE; LpDc ^= LpD; LpLc ^= LpL; LpFc ^= LpF;
           LpDp ^= LpD;
           Cd <= cons LpDp (cons (cons 'lcheck (cons LpEc (cons LpDc (cons LpLc (cons LpFc nil))))) Cd);
           LpE ^= LpE; LpD ^= LpD; LpL ^= LpL; LpF ^= LpF
         else
           'error <= '40
         fi LpVE;
         LpVE ^= LpVE;
         LpTE ^= 'S
       else
         (* dynamic entry test: residualize whole loop (entry test lifted) *)
         LpRE <= cons LpTE LpVE;
         AV-LIFT(LpRE, LpLEe);
         LpRE ^= LpRE;
         LpE ^= LpE;
         Arg <= cons LpLEe (cons LpD (cons LpL (cons LpF nil)));
         LpCl ^= Arg;
         RCode <= cons (cons 'loop LpCl) RCode;
         Arg ^= Arg
       fi LpCEs;
       LpCEs ^= LpCEs
     else
      if =? Tag 'lcheck then
        cons LpE (cons LpD (cons LpL (cons LpF nil))) <= Arg;
        SPEC-EXP-AV(LpF, LpRF);
        cons LpTF LpVF <= LpRF;
        LpCFs ^= =? LpTF 'S;
        if LpCFs then
          if LpVF then
            (* exit test true: loop finished *)
            LpE ^= LpE; LpD ^= LpD; LpL ^= LpL; LpF ^= LpF
          else
            (* exit test false: run L, then D, then re-check via 'lcheck *)
            LpEc ^= LpE; LpDc ^= LpD; LpLc ^= LpL; LpFc ^= LpF;
            LpLp ^= LpL; LpDp ^= LpD;
            Cd <= cons LpLp (cons LpDp (cons (cons 'lcheck (cons LpEc (cons LpDc (cons LpLc (cons LpFc nil))))) Cd));
            LpE ^= LpE; LpD ^= LpD; LpL ^= LpL; LpF ^= LpF
          fi LpVF;
          LpVF ^= LpVF;
          LpTF ^= 'S
        else
          'error <= '41
        fi LpCFs;
        LpCFs ^= LpCFs
      else
       if =? Tag 'seq then
         (* push both subcommands onto the work stack; the shell is discarded,
          * so no seqB/seqE reconstruction is needed (and cond/loop nested in a
          * seq do not corrupt a shell stack). *)
         cons C D <= Arg;
         Cd <= cons C (cons D Cd)
       else
         'error <= '1
       fi =? Tag 'seq
      fi =? Tag 'lcheck
     fi =? Tag 'loop
    fi =? Tag 'cond
   fi =? Tag 'rep
  fi =? Tag 'ass;
  Cd' <= cons (cons Tag Arg) Cd'

(* SPEC-CMD-AV(Cmd): run SPEC-STEP-AV over Cmd; the residual program accumulates
 * in RCode (reverse order).  Cmd is consumed into the work stack; the shell
 * (Cd') is discarded (we do not reconstruct the source command — the residual is
 * what matters).  Note: injectivity embedding of the source is a Stage-C concern. *)
macro SPEC-CMD-AV(Cmd)
  Cd <= cons Cmd nil;
  from (=? Cd' nil) loop
    SPEC-STEP-AV(Cd, Cd', RCode)
  until (=? Cd nil);
  Cd' ^= Cd'

(* ===== Main program ===== *)
(* Default main: a test harness for SPEC-EXP-AV; input (Vl . E), output
 * (Vl . (E . RE)).  (Other harnesses are injected via parse_macro_harness.) *)

read In;
  cons Vl E <= In;
  SPEC-EXP-AV(E, RE);
  Out <= cons Vl (cons E RE);
write Out
