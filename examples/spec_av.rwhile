(*
 * spec_av.rwhile - WIP: AV-based (partially-static) specializer for R-WHILE.
 *
 * Developed in parallel with spec.rwhile (the working baseline) so the rewrite
 * to partially-static values does not break it.  See
 * analysis_partial_static_design.md.  This file currently contains:
 *   - the partial store ops (AUX / LOOKUP / UPDATE), same as spec.rwhile
 *   - the AV algebra (AV-CONS/HD/TL/LIFT/EQ), same as av.rwhile
 *   - SPEC-EXP-AV: an AV-based expression specializer (the step-2 deliverable)
 *
 * Annotated value (AV):
 *   ('S . v)            static value v
 *   ('D . code)         dynamic, residual expression code
 *   ('C . (av1 . av2))  partially-static cons
 * Store slot Vl[k] holds an AV (dynamic slots are ('D . ('var . k))).
 *)

(* ===== Partial store ops (identical to spec.rwhile) ===== *)

(* Hygiene-clean: AUX's working set is threaded through parameters (Elem, Rest,
   Rev, Cnt) instead of shared locals. U is a true per-iteration local. *)
macro LOOKUP(Vl,J,X)
  AUX(Vl,J,Elem,Rest,Rev,Cnt);
  X ^= Elem;
  INV-AUX(Vl,J,Elem,Rest,Rev,Cnt)

macro UPDATE(Vl,J,X)
  AUX(Vl,J,Elem,Rest,Rev,Cnt);
  Elem ^= X;
  INV-AUX(Vl,J,Elem,Rest,Rev,Cnt)

macro AUX(Vl,J,Elem,Rest,Rev,Cnt)
  from (=? Cnt nil) loop
    cons U Vl <= Vl;
    Rev <= cons U Rev;
    Cnt <= cons nil Cnt
  until (=? Cnt J);
  cons Elem Rest <= Vl

(* ===== AV algebra (identical to av.rwhile) ===== *)

macro AV-HD(A, R)
  cons T V <= A;
  CT ^= =? T 'S;
  if =? T 'S then
    cons H Tl <= V;
    Tl ^= Tl;
    R <= cons 'S H;
    T ^= 'S
  else
    CC ^= =? T 'C;
    if =? T 'C then
      cons A1 A2 <= V;
      A2 ^= A2;
      R <= A1;
      T ^= 'C
    else
      R <= cons 'D (cons 'hd V);
      T ^= 'D
    fi CC;
    CC ^= CC
  fi CT;
  CT ^= CT

macro AV-TL(A, R)
  cons T V <= A;
  CT ^= =? T 'S;
  if =? T 'S then
    cons H Tl <= V;
    H ^= H;
    R <= cons 'S Tl;
    T ^= 'S
  else
    CC ^= =? T 'C;
    if =? T 'C then
      cons A1 A2 <= V;
      A1 ^= A1;
      R <= A2;
      T ^= 'C
    else
      R <= cons 'D (cons 'tl V);
      T ^= 'D
    fi CC;
    CC ^= CC
  fi CT;
  CT ^= CT

(* AV-PAIRP(A, R): partial-static `pair? A`.
 *  - static ('S.v)            -> statically known bool ('S.(nil.nil)) / ('S.nil)
 *  - partial-static cons ('C) -> definitely a cons -> static TRUE ('S.(nil.nil))
 *  - dynamic ('D.code)        -> residual ('D.('pairp.code))
 * A is consumed (like AV-HD/AV-TL). *)
macro AV-PAIRP(A, R)
  cons T V <= A;
  PpS ^= =? T 'S;
  if =? T 'S then
    PpB ^= pair? V;            (* PpB = (nil.nil) if V is a cons else nil; V preserved *)
    R <= cons 'S PpB;          (* R = ('S . bool); PpB consumed *)
    V ^= V;                    (* clear the static value *)
    T ^= 'S
  else
    PpC ^= =? T 'C;
    if =? T 'C then
      V ^= V;                  (* discard (a1.a2): a 'C is always a cons *)
      R <= cons 'S (nil.nil);  (* static TRUE *)
      T ^= 'C
    else
      R <= cons 'D (cons 'pairp V);   (* dynamic: residual pair?; V consumed *)
      T ^= 'D
    fi PpC;
    PpC ^= PpC
  fi PpS;
  PpS ^= PpS

macro AV-CONS(A1, A2, R)
  cons T1 V1 <= A1;
  cons T2 V2 <= A2;
  S1 ^= =? T1 'S;
  S2 ^= =? T2 'S;
  Both ^= nil;
  if S1 then
    if S2 then Both ^= (nil.nil) fi S2
  fi S1;
  CBoth ^= Both;
  if Both then
    R <= cons 'S (cons V1 V2);
    T1 ^= 'S; T2 ^= 'S
  else
    A1 <= cons T1 V1;
    A2 <= cons T2 V2;
    R <= cons 'C (cons A1 A2)
  fi CBoth;
  CBoth ^= CBoth;
  Both ^= Both;
  S1 ^= S1;
  S2 ^= S2

macro AV-LIFT(A, Code)
  A <= cons A nil;
  from (=? A' nil) loop
    AV-LIFT-STEP(A, A', RSt)
  until (=? A nil);
  cons A nil <= A';
  cons Code nil <= RSt

macro AV-LIFT-STEP(Wk, Wk', RSt)
  cons (cons LfTag LfPay) Wk <= Wk;
  if =? LfTag 'S then
    LfPayC ^= LfPay;
    RSt <= cons (cons 'val LfPayC) RSt
  else
   if =? LfTag 'D then
     LfPayC ^= LfPay;
     RSt <= cons LfPayC RSt
   else
    if =? LfTag 'C then
      LfTag ^= 'C; LfTag ^= 'CB;
      cons LfX LfY <= LfPay;
      Wk <= cons LfX (cons LfY (cons ('CE . nil) Wk));
      LfX ^= LfX; LfY ^= LfY
    else
     if =? LfTag 'CE then
       LfTag ^= 'CE; LfTag ^= 'C;
       cons LfY (cons LfX (cons ('CB . nil) Wk')) <= Wk';
       LfPay <= cons LfX LfY;
       cons LfQ (cons LfP RSt) <= RSt;
       RSt <= cons (cons 'cons (cons LfP LfQ)) RSt
     else
       'error <= '9
     fi =? LfTag 'C
    fi =? LfTag 'CB
   fi =? LfTag 'D
  fi =? LfTag 'S;
  Wk' <= cons (cons LfTag LfPay) Wk'

(* AV-UNCONS(A, A1, A2): split a cons-shaped AV into its two components
 * ('C/'S-cons split; 'D symbolic). Used for partially-static pattern reads. *)
macro AV-UNCONS(A, A1, A2)
  cons T V <= A;
  CUs ^= =? T 'S;
  if =? T 'S then
    (* A static value is splittable only if it is actually a cons.  Splitting a
     * static non-cons (atom/nil) is a static pattern-match FAILURE (dead/impossible
     * position during PE); produce a degenerate ('S.nil) split instead of crashing
     * on `cons H Tl <= nil`. *)
    CUp ^= pair? V;
    if CUp then
      cons H Tl <= V;
      A1 <= cons 'S H;
      A2 <= cons 'S Tl
    else
      V ^= V;
      A1 <= cons 'S nil;
      A2 <= cons 'S nil
    fi CUp;
    CUp ^= CUp;
    T ^= 'S
  else
    CUc ^= =? T 'C;
    if =? T 'C then
      cons A1 A2 <= V;
      T ^= 'C
    else
      Vc ^= V;
      A1 <= cons 'D (cons 'hd V);
      A2 <= cons 'D (cons 'tl Vc);
      T ^= 'D
    fi CUc;
    CUc ^= CUc
  fi CUs;
  CUs ^= CUs

macro AV-EQ(A1, A2, R)
  cons T1 V1 <= A1;
  cons T2 V2 <= A2;
  BothS ^= nil;
  if =? T1 'S then
    if =? T2 'S then BothS ^= (nil.nil) fi =? T2 'S
  fi =? T1 'S;
  CBothS ^= BothS;
  if BothS then
    EqRes ^= =? V1 V2;
    R <= cons 'S EqRes;
    V1 ^= V1; V2 ^= V2;
    T1 ^= 'S; T2 ^= 'S
  else
    A1 <= cons T1 V1;
    A2 <= cons T2 V2;
    AV-LIFT(A1, C1);
    AV-LIFT(A2, C2);
    A1 ^= A1; A2 ^= A2;
    R <= cons 'D (cons 'eq (cons C1 C2))
  fi CBothS;
  CBothS ^= CBothS;
  BothS ^= BothS

(* MAKE-SEQ(RCode, Cmd): fold a reverse-ordered residual list into one 'seq
 * command (execution order = oldest first). RCode must be non-empty. *)
macro MAKE-SEQ(RCode, Cmd)
  from (=? Cmd nil) loop
    cons MsC RCode <= RCode;
    MsNil ^= =? Cmd nil;
    if =? Cmd nil then
      Cmd ^= MsC
    else
      Cmd <= cons 'seq (cons MsC Cmd)
    fi MsNil;
    MsNil ^= MsNil;
    MsC ^= MsC
  until (=? RCode nil)

(* ASSEMBLE-FP1(I', J', CompSrc): build the residual program comp_src from the
 * post-specialization store Vl and residual list RCode (both in scope).
 *   materialize(J')  = J' <= lift(Vl[J'])   (rebuild the output var from its AV;
 *                       runs LAST, so prepend it to the reverse-ordered RCode)
 *   body            = MAKE-SEQ(RCode)
 *   CompSrc         = (('var.I') . (body . ('var.J')))   (p2d program form)
 * I' and J' are variables holding the read/write variable indices; both preserved. *)
macro ASSEMBLE-FP1(I', J', CompSrc)
  LOOKUP(Vl, J', AsAV);                 (* AsAV = output slot AV (copy) *)
  AV-LIFT(AsAV, AsCode);                (* AsCode = residual code; AsAV preserved *)
  LOOKUP(Vl, J', AsAV);                 (* clear AsAV (XOR same value -> nil) *)
  AsJ ^= J';
  RCode <= cons (cons 'rep (cons (cons 'var AsJ) AsCode)) RCode;
  MAKE-SEQ(RCode, AsBody);
  AsI ^= I';
  AsJ2 ^= J';
  CompSrc <= cons (cons 'var AsI) (cons AsBody (cons 'var AsJ2))

(* AV-INIT(N, Vl): Vl := a store of N AV slots, each static-nil ('S.nil).
 * (The specialized program's variables all start nil = statically-known nil;
 * only the read-variable slot is later overwritten with the partial input AV.)
 * N is a unary count (0=nil, 1=(nil.nil), ...); it is preserved. *)
macro AV-INIT(N, Vl)
  from (=? AiK nil) loop
    Vl <= cons (cons 'S nil) Vl;
    AiK <= cons nil AiK
  until (=? AiK N);
  AiK ^= N

(* DYNAMICIZE-ALL(Vl, RCode): make every store slot dynamic & self-referential
 * ('D.('var.k)), MATERIALISING any static-non-nil or partial-static slot first
 * (emit `('var.k) <= lift(slot)` into RCode) so that a following residual
 * dynamic region (a residualised cond/loop) sees the correct runtime value.
 * Slots already static-nil or dynamic need no materialisation.  Slot order is
 * preserved.  Conservative (dynamicises the whole store) but sound: it stops
 * stale static values from leaking past a dynamic branch.  Vl must be non-empty. *)
macro DYNAMICIZE-ALL(Vl, RCode)
  DaK ^= nil;                        (* running index (unary) *)
  DaRev ^= nil;                      (* reversed accumulator of new slots *)
  from (=? DaRev nil) loop
    cons DaSlot Vl <= Vl;            (* pop old slot k; Vl = rest *)
    cons DaT DaV <= DaSlot;          (* slot = (DaT . DaV) *)
    DaMat ^= nil;
    if =? DaT 'S then
      if =? DaV nil else DaMat ^= (nil.nil) fi =? DaV nil
    fi =? DaT 'S;
    if =? DaT 'C then DaMat ^= (nil.nil) fi =? DaT 'C;
    DaSlot <= cons DaT DaV;          (* reassemble slot (DaT,DaV consumed) *)
    if DaMat then
      DaKc ^= DaK;
      AV-LIFT(DaSlot, DaCode);       (* DaSlot preserved; DaCode = lifted code *)
      RCode <= cons (cons 'rep (cons (cons 'var DaKc) DaCode)) RCode
    fi DaMat;
    DaMat ^= DaMat;
    cons DaOt DaOv <= DaSlot; DaOt ^= DaOt; DaOv ^= DaOv;   (* clear old slot *)
    DaKc2 ^= DaK;
    DaRev <= cons (cons 'D (cons 'var DaKc2)) DaRev;
    DaK <= cons nil DaK
  until (=? Vl nil);
  from (=? Vl nil) loop
    cons DaRS DaRev <= DaRev;
    Vl <= cons DaRS Vl
  until (=? DaRev nil);
  DaK ^= DaK

(* ===== AV-based expression specializer ===== *)

(* SPEC-EXP-AV(E, RE): RE := AV result of specializing expression E against the
 * AV store Vl.  E is preserved (shell reconstructed), like spec.rwhile's
 * SPEC-EXP. Stack machine: Cd = work stack, Cd' = done stack, RSt = AV results. *)
macro SPEC-EXP-AV(E, RE)
  E <= cons E nil;
  from (=? E' nil) loop
    SPEC-EXP-AV-STEP(E, E', RSt)
  until (=? E nil);
  cons E nil <= E';
  cons RE nil <= RSt

macro SPEC-EXP-AV-STEP(Cd, Cd', RSt)
  cons (cons ETag EArg) Cd <= Cd;
  case ETag yields ETag of
     'var    => LOOKUP(Vl, EArg, SX); RSt <= cons SX RSt => 'var
   | 'val    => EArgCopy ^= EArg; RSt <= cons (cons 'S EArgCopy) RSt => 'val
   | 'cons   => cons E1 E2 <= EArg; Cd <= cons E1 (cons E2 (cons ('consE . nil) Cd)) => 'consB
   | 'consE  => cons E2 (cons E1 (cons ('consB . nil) Cd')) <= Cd'; EArg <= cons E1 E2;
                cons R2 (cons R1 RSt) <= RSt; AV-CONS(R1, R2, Rc); RSt <= cons Rc RSt => 'cons
   | 'hd     => Cd <= cons EArg (cons ('hdE . nil) Cd) => 'hdB
   | 'hdE    => cons EArg (cons ('hdB . nil) Cd') <= Cd'; cons R1 RSt <= RSt;
                AV-HD(R1, Rh); RSt <= cons Rh RSt => 'hd
   | 'tl     => Cd <= cons EArg (cons ('tlE . nil) Cd) => 'tlB
   | 'tlE    => cons EArg (cons ('tlB . nil) Cd') <= Cd'; cons R1 RSt <= RSt;
                AV-TL(R1, Rt); RSt <= cons Rt RSt => 'tl
   | 'eq     => cons E1 E2 <= EArg; Cd <= cons E1 (cons E2 (cons ('eqE . nil) Cd)) => 'eqB
   | 'eqE    => cons E2 (cons E1 (cons ('eqB . nil) Cd')) <= Cd'; EArg <= cons E1 E2;
                cons R2 (cons R1 RSt) <= RSt; AV-EQ(R1, R2, Re); RSt <= cons Re RSt => 'eq
   | 'pairp  => Cd <= cons EArg (cons ('pairpE . nil) Cd) => 'pairpB
   | 'pairpE => cons EArg (cons ('pairpB . nil) Cd') <= Cd'; cons R1 RSt <= RSt;
                AV-PAIRP(R1, Rp); RSt <= cons Rp RSt => 'pairp
   | W       => 'error <= '0 => nil
  end;
  Cd' <= cons (cons ETag EArg) Cd'

(* ===== AV pattern helpers (for 'rep), ported from spec.rwhile =====
 * Store slots are AVs: static ('S.v), dynamic ('D.('var.k)).  These handle
 * 'var, 'val and one level of 'cons (the SIMPLE forms). *)

macro PAT-LEAF-STATIC-AV(PP, Stat)
  case PP yields PP of
      cons 'var PLSag => LOOKUP(Vl, PLSag, PLSsv); Stat ^= =? (hd PLSsv) 'S; PLSsv ^= PLSsv => cons 'var PLSag
    | Rest => Stat ^= (nil.nil) => Rest
  end

macro CHECK-PAT-STATIC-AV(PP, Stat)
  case PP yields PP of
      cons 'cons CPSag => cons CPSp1 CPSp2 <= CPSag; PAT-LEAF-STATIC-AV(CPSp1, CPS1); PAT-LEAF-STATIC-AV(CPSp2, CPS2); if CPS1 then if CPS2 then Stat ^= (nil.nil) fi CPS2 fi CPS1; CPS1 ^= CPS1; CPS2 ^= CPS2; CPSag <= cons CPSp1 CPSp2 => cons 'cons CPSag
    | Rest => PAT-LEAF-STATIC-AV(Rest, Stat) => Rest
  end

(* PAT-READ-LEAF-AV: read a static leaf value into PV; set 'var slot to dynamic. *)
macro PAT-READ-LEAF-AV(PP, PV)
  case PP yields PP of
      cons 'var PRLag => LOOKUP(Vl, PRLag, PRLsv); PV ^= tl PRLsv; UPDATE(Vl, PRLag, PRLsv); PRLsv ^= PRLsv; PRLagc ^= PRLag; PRLsv <= cons 'D (cons 'var PRLagc); UPDATE(Vl, PRLag, PRLsv); cons PRLdd PRLdr <= PRLsv; PRLdd ^= PRLdd; PRLdr ^= PRLdr => cons 'var PRLag
    | Rest => PV ^= tl Rest => Rest
  end

macro PAT-READ-SIMPLE-AV(PP, PV)
  case PP yields PP of
      cons 'cons PRSag => cons PRSp1 PRSp2 <= PRSag; PAT-READ-LEAF-AV(PRSp1, PRSv1); PAT-READ-LEAF-AV(PRSp2, PRSv2); PV <= cons PRSv1 PRSv2; PRSag <= cons PRSp1 PRSp2 => cons 'cons PRSag
    | Rest => PAT-READ-LEAF-AV(Rest, PV) => Rest
  end

(* PAT-WRITE-LEAF-AV: write static value PV into 'var slot as ('S.PV); 'dynamic
 * marker sets the slot dynamic instead. *)
macro PAT-WRITE-LEAF-AV(PP, PV)
  case PP yields PP of
      cons 'var PWLag => LOOKUP(Vl, PWLag, PWLsv); UPDATE(Vl, PWLag, PWLsv); PWLsv ^= PWLsv; IsDyn ^= =? PV 'dynamic; if IsDyn then PWLagc ^= PWLag; PWLsv <= cons 'D (cons 'var PWLagc); UPDATE(Vl, PWLag, PWLsv); cons PWLdd PWLdr <= PWLsv; PWLdd ^= PWLdd; PWLdr ^= PWLdr; PV ^= 'dynamic else PWLsv <= cons 'S PV; UPDATE(Vl, PWLag, PWLsv); cons PWLss PWLsval <= PWLsv; PWLss ^= PWLss; PWLsval ^= PWLsval fi IsDyn; IsDyn ^= IsDyn => cons 'var PWLag
    | Rest => PV ^= PV => Rest
  end

macro PAT-WRITE-SIMPLE-AV(PP, PV)
  case PP yields PP of
      cons 'cons PWSag => cons PWSp1 PWSp2 <= PWSag; cons PWSv1 PWSv2 <= PV; PAT-WRITE-LEAF-AV(PWSp1, PWSv1); PAT-WRITE-LEAF-AV(PWSp2, PWSv2); PWSag <= cons PWSp1 PWSp2 => cons 'cons PWSag
    | Rest => PAT-WRITE-LEAF-AV(Rest, PV) => Rest
  end

macro PAT-CLR-LEAF-AV(PP)
  case PP yields PP of
      cons 'var PCLag => LOOKUP(Vl, PCLag, PCLsv); UPDATE(Vl, PCLag, PCLsv); PCLsv ^= PCLsv; PCLagc ^= PCLag; PCLsv <= cons 'D (cons 'var PCLagc); UPDATE(Vl, PCLag, PCLsv); cons PCLdd PCLdr <= PCLsv; PCLdd ^= PCLdd; PCLdr ^= PCLdr => cons 'var PCLag
    | Rest => nil <= nil => Rest
  end

macro PAT-CLR-SIMPLE-AV(PP)
  case PP yields PP of
      cons 'cons PCSag => cons PCSp1 PCSp2 <= PCSag; PAT-CLR-LEAF-AV(PCSp1); PAT-CLR-LEAF-AV(PCSp2); PCSag <= cons PCSp1 PCSp2 => cons 'cons PCSag
    | Rest => PAT-CLR-LEAF-AV(Rest) => Rest
  end

(* ===== AV-aware pattern read/write (for partially-static 'rep) =====
 * Read a pattern into an AV (consuming its vars); write an AV into a pattern.
 * cons patterns split/combine via AV-CONS / AV-UNCONS, so partially-static
 * structures (e.g. (prog.data)) are handled without losing the static part. *)

macro PAT-READ-LEAF-AV2(P, RA)
  case P yields P of
      cons 'var PRLi => LOOKUP(Vl, PRLi, PRLs); RA ^= PRLs; UPDATE(Vl, PRLi, PRLs); PRLs ^= PRLs; PRLs <= cons 'S nil; UPDATE(Vl, PRLi, PRLs); cons PRLss PRLsv <= PRLs; PRLss ^= PRLss; PRLsv ^= PRLsv => cons 'var PRLi
    | Rest => PRLv ^= tl Rest; RA <= cons 'S PRLv => Rest
  end

macro PAT-READ-AV(P, RA)
  case P yields P of
      cons 'cons PRag => cons PRp1 PRp2 <= PRag; PAT-READ-LEAF-AV2(PRp1, PRa1); PAT-READ-LEAF-AV2(PRp2, PRa2); AV-CONS(PRa1, PRa2, RA); PRag <= cons PRp1 PRp2 => cons 'cons PRag
    | Rest => PAT-READ-LEAF-AV2(Rest, RA) => Rest
  end

(* PAT-READ-ITER(P, RA): like PAT-READ-AV but for ARBITRARY-DEPTH (nested)
 * patterns.  Macros cannot recurse, so this is an iterative worklist tree-fold
 * (modeled on AV-LIFT's begin/end markers): it reads pattern P (preserved) and
 * builds its AV RA bottom-up, combining nested conses via AV-CONS.  Depth-1
 * PAT-READ-AV mis-reads a nested sub-cons as a static literal ('S.(tl P)) via
 * PAT-READ-LEAF-AV2's leaf else-branch; ASSEMBLE-FP1's nested output pattern
 * (cons (cons 'var I) (cons Body (cons 'var J))) needs the depth-general read,
 * else the residual bakes the inner cons as a constant and never assembles. *)
macro PAT-READ-ITER-STEP(Wk, Wk', PrSt, RCode)
  cons PrP Wk <= Wk;
  case PrP yields PrP of
      cons 'cons PrAg => cons PrX PrY <= PrAg; Wk <= cons PrX (cons PrY (cons (cons 'consE nil) Wk)); PrX ^= PrX; PrY ^= PrY => cons 'consB PrAg
    | cons 'consE PrAg2 => cons PrY (cons PrX (cons (cons 'consB nil) Wk')) <= Wk'; PrAg2 <= cons PrX PrY; cons PrA2 (cons PrA1 PrSt) <= PrSt; AV-CAPTURE(PrA1, RCode); AV-CAPTURE(PrA2, RCode); AV-CONS(PrA1, PrA2, PrAc); PrSt <= cons PrAc PrSt => cons 'cons PrAg2
    | Rest => PAT-READ-LEAF-AV2(Rest, PrLa); PrSt <= cons PrLa PrSt => Rest
  end;
  Wk' <= cons PrP Wk'

macro PAT-READ-ITER(P, RA, RCode)
  P <= cons P nil;
  from (=? P' nil) loop
    PAT-READ-ITER-STEP(P, P', PrSt, RCode)
  until (=? P nil);
  cons P nil <= P';
  cons RA nil <= PrSt

macro PAT-WRITE-LEAF-AV2(P, WA)
  case P yields P of
      cons 'var PWLi => LOOKUP(Vl, PWLi, PWLs); UPDATE(Vl, PWLi, PWLs); PWLs ^= PWLs; PWLs <= WA; UPDATE(Vl, PWLi, PWLs); cons PWLss PWLsv <= PWLs; PWLss ^= PWLss; PWLsv ^= PWLsv => cons 'var PWLi
    | Rest => WA ^= WA => Rest
  end

macro PAT-WRITE-AV(P, WA)
  case P yields P of
      cons 'cons PWag => cons PWp1 PWp2 <= PWag; AV-UNCONS(WA, PWa1, PWa2); PAT-WRITE-LEAF-AV2(PWp1, PWa1); PAT-WRITE-LEAF-AV2(PWp2, PWa2); PWag <= cons PWp1 PWp2 => cons 'cons PWag
    | Rest => PAT-WRITE-LEAF-AV2(Rest, WA) => Rest
  end

(* TEMP-IDX(T): T := the reserved unary temp-variable index 100, used as the
 * scratch slot for swap-via-temp.  100 is above every interpreted program's
 * variable indices and within ri.rwhile's store, so it never collides. *)
macro TEMP-IDX(TmpT)
  TmpT ^= (nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.nil))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))

(* TMP-ALLOC(T): T := a FRESH residual variable index, and bump the counter.
 * TEMP-IDX hands out one fixed index (100), which SWAP-VIA-TEMP can use only
 * because it consumes it immediately.  TmpCtr is a global initialised to 100 in
 * main and self-cleared there; each call returns the current value and adds one
 * nil, so successive calls cannot collide, and the indices stay above every
 * interpreted program's variable indices. *)
macro TMP-ALLOC(TaT)
  TaT ^= TmpCtr;
  TmpCtr <= cons nil TmpCtr

(* AV-CAPTURE(A, RCode): if A is a bare dynamic SLOT REFERENCE ('D.('var.k)),
 * MOVE that slot's run-time value into a freshly allocated temp and return
 * ('D.('var.Tmp)) instead.
 *
 * This is CAPTURE-ON-ESCAPE, and it is the answer to constraint C2.  The AV
 * ('D.('var.k)) names a MUTABLE SLOT, not a value: the moment slot k is
 * re-assigned, every copy of that AV still reads as "the value of variable k"
 * while denoting something else.  A copy that has ESCAPED -- been embedded in a
 * compound by AV-CONS, e.g. onto ri_fp3's stack -- cannot be reached and
 * re-pointed later, so it must be made independent AT THE MOMENT IT ESCAPES.
 *
 * The capture is emitted as a 'rep (`Tmp <= ('var.k)`), never as an 'ass with a
 * lifted expression.  That is deliberate and is what killed capture-always:
 * a 'rep's right-hand side is a PATTERN, so it CONSUMES slot k -- the value
 * moves, the slot is freed for reuse, and the temp is later consumed in turn by
 * the pattern write that delivers the compound (C3).  Nothing is erased, so no
 * self-clear is needed in the residual (C4).  Slot k's AV entry is already
 * ('S.nil) -- PAT-READ-LEAF-AV2 left it that way when it handed the reference
 * out -- so the AV store needs no update here.
 *
 * Only bare ('D.('var.k)) is captured: other dynamics ('D.('pairp ...) etc.)
 * are computed expressions, not slot references, and a compound 'C AV holds
 * leaves that were already captured when THEY escaped, so there is no chaining. *)
macro AV-CAPTURE(A, RCode)
  CapD ^= =? (hd A) 'D;
  if CapD then
    cons CapT CapP <= A;
    CapV ^= =? (hd CapP) 'var;
    if CapV then
      cons CapVt CapK <= CapP;
      TMP-ALLOC(CapNew);
      CapKc ^= CapK;
      CapNc ^= CapNew;
      RCode <= cons (cons 'rep (cons (cons 'var CapNc) (cons 'var CapKc))) RCode;
      CapK ^= CapK;
      CapP <= cons CapVt CapNew
    fi CapV;
    CapV ^= CapV;
    A <= cons CapT CapP
  fi CapD;
  CapD ^= CapD

(* SET-SELF-SLOT(I): set store slot I to the self-referential dynamic ('D.('var.I)),
 * re-establishing the no-alias invariant after a runtime move/swap.  I preserved. *)
macro SET-SELF-SLOT(SsI)
  LOOKUP(Vl, SsI, SsOld); UPDATE(Vl, SsI, SsOld); SsOld ^= SsOld;   (* clear slot *)
  SsIc ^= SsI;
  SsNew <= cons 'D (cons 'var SsIc);
  UPDATE(Vl, SsI, SsNew);                                          (* slot := ('D.('var.I)) *)
  cons SsN1 SsN2 <= SsNew; SsN1 ^= SsN1;
  cons SsN3 SsN4 <= SsN2; SsN3 ^= SsN3; SsN4 ^= SsN4

(* SWAP-VIA-TEMP(I1, I2, RCode): realize a runtime SWAP of variables V_I1 and V_I2
 * (a transposition of two live dynamic values) reversibly using a temp variable
 * 'tmp (an atom index, distinct from every unary program-variable index, so it
 * cannot collide).  A plain `V_I1<=V_I2; V_I2<=V_I1` is irreversible (both targets
 * are non-nil at runtime); the temp breaks the 2-cycle:
 *     tmp <= V_I1 ;  V_I1 <= V_I2 ;  V_I2 <= tmp
 * RCode is prepended (save, move, restore) so the global reverse yields that order.
 * Both slots are reset to self-referential dynamics.  I1, I2 preserved. *)
macro SWAP-VIA-TEMP(SvI1, SvI2, RCode)
  TEMP-IDX(SvT1);
  SvSi1 ^= SvI1;
  RCode <= cons (cons 'rep (cons (cons 'var SvT1) (cons 'var SvSi1))) RCode;   (* tmp <= V_I1 *)
  SvMi1 ^= SvI1; SvMi2 ^= SvI2;
  RCode <= cons (cons 'rep (cons (cons 'var SvMi1) (cons 'var SvMi2))) RCode;  (* V_I1 <= V_I2 *)
  TEMP-IDX(SvT2);
  SvRi2 ^= SvI2;
  RCode <= cons (cons 'rep (cons (cons 'var SvRi2) (cons 'var SvT2))) RCode;   (* V_I2 <= tmp *)
  SET-SELF-SLOT(SvI1);
  SET-SELF-SLOT(SvI2)

(* ===== Structural AV pattern write (Stage C, for fp1) =====
 * Write AV WA into pattern P, residualizing into RCode the ONE case that cannot
 * be done reversibly in the AV domain: splitting a *pure dynamic* value into a
 * cons pattern (symbolic hd/tl would read the dynamic value twice = irreversible).
 *  - P var/val leaf      -> slot := WA (alias / static), no residual.
 *  - P cons, WA cons-shaped ('C / 'S-cons) -> AV-UNCONS + write components,
 *    no residual (this is the partially-static INPUT SPLIT: static parts kept).
 *  - P cons, WA pure 'D leaf -> emit residual `P <= <code of WA>` and set P's
 *    vars dynamic.  The residual reuses the source variable indices carried by
 *    the 'D marker (same namespace as residualized 'ass), so no fresh allocator.
 * One-level on the cons LHS, like PAT-WRITE-SIMPLE-AV (macros cannot recurse). *)
macro PAT-WRITE-STRUCT(P, WA, RCode)
  if =? (hd P) 'cons then
    WSisD ^= =? (hd WA) 'D;
    if WSisD then
      (* dynamic cons-split: residualize the rep, set P's vars dynamic *)
      cons WSt WScode <= WA;            (* WA = ('D . code); WA -> nil *)
      WSt ^= 'D;
      PAT-CLR-SIMPLE-AV(P);             (* P's vars -> ('D.('var.k)); P preserved *)
      WSPc ^= P;                        (* copy P for the residual LHS *)
      RCode <= cons (cons 'rep (cons WSPc WScode)) RCode
    else
      cons WStg WSag <= P;
      cons WSp1 WSp2 <= WSag;
      AV-UNCONS(WA, WSa1, WSa2);        (* WA is 'C or 'S here: real split *)
      (* Detect a TRANSPOSITION of the two leaf variables: both leaves are vars
       * (idx i1,i2) and each sub-AV is the dynamic reference to the OTHER leaf's
       * variable (WSa1=('D.('var.i2)), WSa2=('D.('var.i1)), i1<>i2).  Two
       * sequential REHOMEs would emit the broken in-place `Vi1<=Vi2; Vi2<=Vi1`
       * (both targets non-nil at runtime); realize it as a swap via a temp var. *)
      WSxp ^= nil;
      if =? (hd WSp1) 'var then
       if =? (hd WSp2) 'var then
        if =? (hd WSa1) 'D then
         if =? (hd (tl WSa1)) 'var then
          if =? (hd WSa2) 'D then
           if =? (hd (tl WSa2)) 'var then
            if =? (tl (tl WSa1)) (tl WSp2) then
             if =? (tl (tl WSa2)) (tl WSp1) then
              if =? (tl WSp1) (tl WSp2) else WSxp ^= (nil.nil) fi =? (tl WSp1) (tl WSp2)
             fi =? (tl (tl WSa2)) (tl WSp1)
            fi =? (tl (tl WSa1)) (tl WSp2)
           fi =? (hd (tl WSa2)) 'var
          fi =? (hd WSa2) 'D
         fi =? (hd (tl WSa1)) 'var
        fi =? (hd WSa1) 'D
       fi =? (hd WSp2) 'var
      fi =? (hd WSp1) 'var;
      if WSxp then
        cons WSxt1 WSxi1 <= WSp1;
        cons WSxt2 WSxi2 <= WSp2;
        SWAP-VIA-TEMP(WSxi1, WSxi2, RCode);
        WSp1 <= cons WSxt1 WSxi1;
        WSp2 <= cons WSxt2 WSxi2;
        WSa1 ^= WSa1; WSa2 ^= WSa2
      else
        PAT-WRITE-LEAF-REHOME(WSp1, WSa1, RCode);
        PAT-WRITE-LEAF-REHOME(WSp2, WSa2, RCode)
      fi WSxp;
      WSxp ^= WSxp;
      WSag <= cons WSp1 WSp2;
      P <= cons WStg WSag
    fi WSisD;
    WSisD ^= WSisD
  else
    PAT-WRITE-LEAF-REHOME(P, WA, RCode)
  fi =? (hd P) 'cons

(* PAT-WRITE-LEAF-REHOME(P, WA, RCode): write AV WA into leaf pattern P (a var),
 * preserving the NO-ALIAS invariant: a dynamic slot k must reference itself
 * ('D.('var.k)), never another variable.  If WA is a dynamic-var leaf
 * ('D.('var.k)) with k <> P's index, we cannot just store it (that aliases var k);
 * instead emit a runtime MOVE  P <= ('var.k)  into RCode and set the slot to the
 * self-reference ('D.('var.P)).  Otherwise (static, partial, self-referential, or
 * non-var-dynamic) store WA directly.  Non-var P: discard WA. *)
macro PAT-WRITE-LEAF-REHOME(P, WA, RCode)
  if =? (hd P) 'var then
    cons RhT RhI <= P;                  (* P = ('var . RhI) *)
    (* Reh = (WA is ('D.('var.k)) with k <> RhI); WA and RhI preserved *)
    if =? (hd WA) 'D then
      if =? (hd (tl WA)) 'var then
        if =? (tl (tl WA)) RhI else Reh ^= (nil.nil) fi =? (tl (tl WA)) RhI
      fi =? (hd (tl WA)) 'var
    fi =? (hd WA) 'D;
    if Reh then
      (* re-home: WA = ('D.('var.k)) -> emit move, slot := ('D.('var.RhI)) *)
      cons RhDt (cons RhVt RhK) <= WA;  (* RhDt='D, RhVt='var, RhK=k; WA=nil *)
      RhDt ^= 'D; RhVt ^= 'var;
      LOOKUP(Vl, RhI, RhOld); UPDATE(Vl, RhI, RhOld); RhOld ^= RhOld;  (* clear slot *)
      RhIc ^= RhI;
      RhNew <= cons 'D (cons 'var RhIc);
      UPDATE(Vl, RhI, RhNew);           (* slot := ('D.('var.RhI)) *)
      cons RhN1 RhN2 <= RhNew; RhN1 ^= RhN1; RhN2 ^= RhN2;
      RhI2 ^= RhI;
      RCode <= cons (cons 'rep (cons (cons 'var RhI2) (cons 'var RhK))) RCode
    else
      (* store WA directly into the slot *)
      LOOKUP(Vl, RhI, RhS); UPDATE(Vl, RhI, RhS); RhS ^= RhS;
      RhS <= WA;                        (* move WA into RhS (WA consumed) *)
      UPDATE(Vl, RhI, RhS);             (* slot := WA (RhS preserved) *)
      cons RhSt RhSv <= RhS; RhSt ^= RhSt; RhSv ^= RhSv
    fi Reh;
    Reh ^= Reh;
    P <= cons RhT RhI
  else
    WA ^= WA
  fi =? (hd P) 'var

(* PAT-WRITE-ITER(P, WA, RCode): write AV WA into pattern P, handling cons
 * patterns of ARBITRARY depth (PAT-WRITE-STRUCT only handled depth 1, dropping
 * the value of any nested cons sub-pattern -- which is exactly ri_fp3's stack
 * split `cons (cons V1e V2e) St <= St`).  Iterative worklist (macros can't
 * recurse): a stack WW of (subPattern . subAV) pairs.  Consumes P and WA.
 *   - subP a var leaf            -> PAT-WRITE-LEAF-REHOME (store/move, no-alias)
 *   - subP a cons, subAV pure-D  -> residualize the whole split; clear subP's
 *                                   (depth-1) leaves to self-referential dynamics
 *   - subP a cons, subAV 'C/'S   -> AV-UNCONS and push the two sub-pairs (spine)
 * Each step pushes a marker onto WW' so the loop entry test stays well-formed;
 * WW' is discarded at the end. *)
macro PAT-WRITE-ITER-STEP(WW, WW', RCode)
  cons (cons WiP WiA) WW <= WW;          (* pop (WiP . WiA) *)
  WiCons ^= =? (hd WiP) 'cons;
  (* A cons pattern whose two immediate leaves are both 'val-literals is a
   * CONSTANT marker pattern (e.g. ri_fp3's `cons 'consB nil`): it asserts the
   * value, it does not bind variables.  Treat it as a leaf assertion (discard
   * the value) rather than splitting it -- splitting would over-decompose and
   * eventually AV-UNCONS a static atom.  (Nested constants are still split by
   * the spine and discarded one level down.) *)
  WiConstP ^= nil;
  if WiCons then
    cons WiCt WiCag <= WiP;
    cons WiCl1 WiCl2 <= WiCag;
    if =? (hd WiCl1) 'val then
      if =? (hd WiCl2) 'val then WiConstP ^= (nil.nil) fi =? (hd WiCl2) 'val
    fi =? (hd WiCl1) 'val;
    WiCag <= cons WiCl1 WiCl2; WiP <= cons WiCt WiCag
  fi WiCons;
  if WiConstP then WiCons ^= WiCons fi WiConstP;  (* constant cons -> handle as leaf *)
  if WiCons then
    WiIsD ^= =? (hd WiA) 'D;
    if WiIsD then
      (* pure-D split: residualize `WiP <= code`, clear WiP's leaves *)
      cons WiDt WiDcode <= WiA; WiDt ^= 'D;        (* WiA = ('D.code) -> consume *)
      PAT-CLR-SIMPLE-AV(WiP);                        (* WiP leaves -> self-ref; WiP preserved *)
      WiPc ^= WiP;                                   (* copy WiP for the residual LHS *)
      RCode <= cons (cons 'rep (cons WiPc WiDcode)) RCode;
      WiP ^= WiP                                     (* discard consumed WiP *)
    else
      (* WiA is 'C or 'S.  'C is always splittable; an 'S value is splittable only
       * if it is actually a cons.  A var-bearing cons pattern meeting a static
       * non-cons (atom/nil) is a static pattern-match FAILURE -> dead position;
       * discard it rather than AV-UNCONS an atom (which would crash). *)
      WiSnc ^= nil;
      if =? (hd WiA) 'S then
        if pair? (tl WiA) else WiSnc ^= (nil.nil) fi pair? (tl WiA)
      fi =? (hd WiA) 'S;
      if WiSnc then
        WiA ^= WiA; WiP ^= WiP                        (* static match failure: drop *)
      else
        (* real split along the spine: uncons WiA, push the two sub-pairs *)
        cons WiTg WiAg <= WiP; WiTg ^= WiTg;          (* drop the 'cons tag *)
        cons WiP1 WiP2 <= WiAg;
        AV-UNCONS(WiA, WiA1, WiA2);
        (* TRANSPOSITION, detected exactly as PAT-WRITE-STRUCT does: both leaves
           are vars and each sub-AV is the dynamic reference to the OTHER leaf's
           variable.  Rehoming them independently emits the broken in-place
           `Vi1 <= Vi2; Vi2 <= Vi1` (both targets non-nil at runtime); realize it
           as a swap through a temp instead.  Without this, wiring PAT-WRITE-ITER
           into the 'rep path made fp1 for ri_seq produce a residual that failed
           at run time (`Pattern write conflict: 5 is already non-nil`). *)
        WiXp ^= nil;
        if =? (hd WiP1) 'var then
         if =? (hd WiP2) 'var then
          if =? (hd WiA1) 'D then
           if =? (hd (tl WiA1)) 'var then
            if =? (hd WiA2) 'D then
             if =? (hd (tl WiA2)) 'var then
              if =? (tl (tl WiA1)) (tl WiP2) then
               if =? (tl (tl WiA2)) (tl WiP1) then
                if =? (tl WiP1) (tl WiP2) else WiXp ^= (nil.nil) fi =? (tl WiP1) (tl WiP2)
               fi =? (tl (tl WiA2)) (tl WiP1)
              fi =? (tl (tl WiA1)) (tl WiP2)
             fi =? (hd (tl WiA2)) 'var
            fi =? (hd WiA2) 'D
           fi =? (hd (tl WiA1)) 'var
          fi =? (hd WiA1) 'D
         fi =? (hd WiP2) 'var
        fi =? (hd WiP1) 'var;
        if WiXp then
          cons WiXt1 WiXi1 <= WiP1;
          cons WiXt2 WiXi2 <= WiP2;
          SWAP-VIA-TEMP(WiXi1, WiXi2, RCode);
          WiP1 <= cons WiXt1 WiXi1;
          WiP2 <= cons WiXt2 WiXi2;
          WiA1 ^= WiA1; WiA2 ^= WiA2;
          WiP1 ^= WiP1; WiP2 ^= WiP2
        else
          WW <= cons (cons WiP1 WiA1) (cons (cons WiP2 WiA2) WW)
        fi WiXp;
        WiXp ^= WiXp
      fi WiSnc;
      WiSnc ^= WiSnc
    fi WiIsD;
    WiIsD ^= WiIsD
  else
    (* var leaf *)
    PAT-WRITE-LEAF-REHOME(WiP, WiA, RCode);          (* WiP preserved, WiA consumed *)
    WiP ^= WiP                                       (* discard consumed WiP *)
  fi WiCons;
  WiCons ^= WiCons;
  WiConstP ^= WiConstP;
  WW' <= cons (nil.nil) WW'                          (* marker: keep loop well-formed *)

macro PAT-WRITE-ITER(P, WA, RCode)
  WW <= cons (cons P WA) nil;            (* seed worklist; P, WA consumed *)
  from (=? WW' nil) loop
    PAT-WRITE-ITER-STEP(WW, WW', RCode)
  until (=? WW nil);
  WW' ^= WW'                             (* discard processed markers *)

(* ===== AV-based command specializer (WIP: 'seq and 'ass) =====
 * SPEC-STEP-AV processes one command; residual commands accumulate in RCode
 * (reverse order).  Store slots are AVs; a dynamic slot is ('D.('var.k)). *)
macro SPEC-STEP-AV(Cd, Cd', RCode)
  cons (cons Tag Arg) Cd <= Cd;
  if =? Tag 'ass then
    cons (cons 'var K) E <= Arg;
    SPEC-EXP-AV(E, RE);
    cons TRE VRE <= RE;            (* RE -> TRE, VRE  (RE = nil) *)
    ExpS ^= =? TRE 'S;
    if ExpS then
      (* static expression value VRE *)
      LOOKUP(Vl, K, AVx);
      UPDATE(Vl, K, AVx);          (* AVx = old slot; slot = nil *)
      cons TAVx VAVx <= AVx;       (* AVx -> TAVx, VAVx  (AVx = nil) *)
      if =? TAVx 'S then
        (* static variable: reversible update of VAVx with VRE *)
        NewV ^= VRE;
        CKNil ^= =? VAVx nil;
        if =? VAVx nil then
          VAVx ^= NewV
        else
          CKNew ^= =? VAVx NewV;
          if =? VAVx NewV then
            VAVx ^= NewV; VAVx ^= nil; NewV ^= VRE
          else
            if =? NewV nil then NewV ^= VRE else 'error <= '10 fi =? NewV VRE
          fi CKNew;
          CKNew ^= CKNew
        fi CKNil;
        CKNil ^= CKNil;
        NewV ^= NewV;
        AVx <= cons TAVx VAVx;     (* reassemble ('S . VAVx') *)
        UPDATE(Vl, K, AVx)         (* slot = new AV  (AVx preserved) *)
      else
        (* dynamic/partial variable, static expr: restore slot, residualize *)
        AVx <= cons TAVx VAVx;
        UPDATE(Vl, K, AVx);        (* slot unchanged  (AVx preserved) *)
        KK ^= K;
        VREc ^= VRE;
        RCode <= cons (cons 'ass (cons (cons 'var KK) (cons 'val VREc))) RCode
      fi =? (hd AVx) 'S;
      cons TAVx VAVx <= AVx;       (* re-split AVx -> clear  (AVx = nil) *)
      TAVx ^= TAVx; VAVx ^= VAVx;
      VRE ^= VRE;
      TRE ^= 'S
    else
      (* dynamic or partial expr: residualize X ^= lift(RE); slot -> dynamic *)
      RE <= cons TRE VRE;          (* reassemble RE *)
      AV-LIFT(RE, LE);             (* AV-LIFT preserves RE *)
      RE ^= RE;
      LOOKUP(Vl, K, AVx);
      UPDATE(Vl, K, AVx);          (* slot = nil; AVx = old *)
      AVx ^= AVx;                  (* discard old AV *)
      KKc ^= K;
      AVx <= cons 'D (cons 'var KKc);
      UPDATE(Vl, K, AVx);          (* slot = ('D.('var.K))  (AVx preserved) *)
      cons TD AVxR <= AVx;         (* re-split -> clear AVx *)
      TD ^= TD; AVxR ^= AVxR;
      KK ^= K;
      RCode <= cons (cons 'ass (cons (cons 'var KK) LE)) RCode
    fi ExpS;
    ExpS ^= ExpS;
    Arg <= cons (cons 'var K) E
  else
   if =? Tag 'rep then
     (* Execute the replacement in the AV domain: read R as an AV, write it into
      * Q.  cons patterns split/combine via AV-UNCONS / AV-CONS, so a partially-
      * static structure (e.g. (prog.data)) is split without losing the static
      * part, and a fully-dynamic value flows symbolically (lifted at output). *)
     cons RpQ RpR <= Arg;
     PAT-READ-ITER(RpR, RpAV, RCode);   (* depth-general read (was PAT-READ-AV, depth-1) *)
     (* PAT-WRITE-ITER handles arbitrary-depth patterns.  PAT-WRITE-STRUCT, which
      * used to be wired here, only handles depth 1 and DROPS the value of any
      * nested cons sub-pattern -- which is exactly ri_fp3's stack split
      * `cons (cons V1e V2e) St <= St`, and why the fp1-via-ri_fp3 residual used
      * to lose its structural ops (swap and sx_splitjoin came out byte-identical,
      * i.e. swap was not actually performed).
      *
      * Wiring PAT-WRITE-ITER was blocked twice, and both blockers are now gone
      * (2026-08-06/07):
      *
      *   1. The note here claimed it made full-ri_fp3 fp1 DIVERGE.  Re-measured:
      *      it does not.  fp1 on ri_fp3 finishes in under a second.
      *   2. The real blocker: fp1 for ri_seq produced a residual that failed at
      *      run time with `Pattern write conflict: 5 is already non-nil`.  Cause:
      *      PAT-WRITE-STRUCT detects a TRANSPOSITION of two leaf variables and
      *      routes it through SWAP-VIA-TEMP, and PAT-WRITE-ITER did not -- it
      *      rehomed the two leaves independently, emitting the broken in-place
      *      `Vi1 <= Vi2; Vi2 <= Vi1`.  The same detector is now in
      *      PAT-WRITE-ITER-STEP's spine-split branch.
      *
      * NOT DONE YET (2026-08-07): preserving the structural ops is not the whole
      * fp1-via-ri_fp3 bug.  The residual for swap now contains them but still
      * fails to run:
      *
      *     4 ^= 15;  15 ^= 4;      -- stage 15's value through working slot 4
      *     4 ^= 16;  16 ^= 4;      -- stage 16's value through 4, still occupied
      *                             --   -> error in update: var=4 cur='b new='a
      *     6 <= 4;   5 <= 4;       -- and 4 is consumed twice as well
      *
      * Two rehomes stage through the SAME working slot without it being freed in
      * between -- the same family as the transposition bug, but at the level of
      * residual sequencing rather than of one cons split.  Pinned by
      * TestSuite's "fp1-via-ri_fp3 KNOWN BUG: residual still fails to run".
      *
      * The remaining failure is EXACTLY the transposition case, and nothing
      * else.  Measured 2026-08-07 over id / id2 / id3 / rep / swap /
      * sx_splitjoin: every non-transposing source now yields a residual that
      * runs and agrees with direct evaluation; only the two that exchange the
      * halves of a cons fail.  And what they used to do was worse than failing:
      * before PAT-WRITE-ITER was wired, swap's residual RAN and returned
      * ('a.'b) -- the input unchanged, where swap must give ('b.'a).  A silent
      * wrong answer.  It is now either right or loud.
      *
      * AND THE REMAINING BUG IS SCHEDULING, NOT CONTENT (measured 2026-08-07).
      * The swap residual contains exactly the right commands; only their order
      * is wrong.  Taking the failing fragment and interleaving each staging with
      * its consumption makes it compute swap correctly:
      *
      *   emitted (fails):   V4^=V15; V15^=V4;  V4^=V16; V16^=V4;  V6<=V4; V5<=V4
      *   interleaved (ok):  V4^=V15; V15^=V4;  V5<=V4;  V4^=V16; V16^=V4; V6<=V4
      *                                                   -> ('b . 'a), correct
      *
      * (The other interleaving, V6<=V4 before V5<=V4, runs but returns ('a.'b) --
      * the identity -- so the PAIRING matters as much as the interleaving.)
      *
      * Cause of the bad order: the rehome moves that PAT-WRITE-LEAF-REHOME emits
      * are deferred to pattern-WRITE time, while ri_fp3's own assignments were
      * residualized earlier.  Both stagings therefore land before both
      * consumptions, and the shared working slot is occupied twice.  The fix is
      * to emit each rehome immediately after the staging that produced it, not
      * at the end -- a scheduling change, with no new residual content.
      *
      * WHY THAT IS NOT A ONE-LINE MOVE (traced 2026-08-07 by putting `show` at
      * every RCode emission point and reading the order).  The emission sequence
      * for swap ends:
      *
      *     ... rehome, rehome, assdyn, assdyn, assdyn, assdyn
      *
      * The two rehomes come out ADJACENT because they are the two var leaves of
      * ONE pattern write, and both of their AVs reference the SAME slot (ri_fp3's
      * working register), not each other -- so the round-8 transposition
      * detector, which looks for a 2-cycle between the two leaves, does not fire.
      * The four assdyn are the two moves that refill that shared slot, emitted
      * separately.  Correct execution needs them interleaved
      * (refill, deliver, refill, deliver); the emitter has no notion of the
      * dependency on the shared slot.
      *
      * CORRECTED 2026-08-07, after checking MAKE-SEQ: program order IS emission
      * order (MAKE-SEQ pops RCode and prepends, undoing the prepend-accumulation),
      * and the 23 traced emissions match the 23 residual commands one for one.
      * With that, the failure reads exactly:
      *
      *     4 ^= 15;  15 ^= 4;      -- stage 15's value into working slot 4
      *     4 ^= 16;                -- stage 16's value into 4, still unconsumed
      *     ...                     --   -> error in update: var=4
      *     6 <= 4;   5 <= 4;       -- the consumptions, both here
      *
      * So it is NOT merely that the emitter schedules badly.  The pattern write
      * holds TWO AVs that both reference slot 4, and a reversible language cannot
      * consume one dynamic slot twice.  The specializer DUPLICATED a dynamic
      * reference; no ordering of the emitted commands can repair that, and the
      * earlier claim in this note that the content was already right (only the
      * order wrong) was too optimistic -- the correct residual needs commands
      * that are not emitted at all.
      *
      * What the fix has to do: capture at READ time, not at write time.  When
      * PAT-READ produces the AV for a dynamic var leaf k, emit `Tmp <= ('var.k)`
      * there and return ('D.('var.Tmp)); the later write then delivers from a
      * private Tmp that nothing else can clobber, and two reads of k get two
      * different Tmps.  This needs a temp ALLOCATOR: TEMP-IDX returns one fixed
      * index, which SWAP-VIA-TEMP can use only because it consumes it
      * immediately.  Allocating reversibly inside spec_av (a reversible program)
      * is the actual work, and it is not small.
      *
      * ROOT CAUSE, finally (2026-08-07, from reading PAT-READ-LEAF-AV2 and the
      * 'ass path together).  `('D.('var.k))` names a MUTABLE SLOT, not a value.
      * PAT-READ-LEAF-AV2 hands out that AV and leaves slot k as ('S.nil); the
      * 'ass path later re-dynamicises the same slot back to ('D.('var.k)).  So:
      *
      *     read slot 4      -> AV1 = ('D.('var.4));  slot 4 := ('S.nil)
      *     'ass  4 ^= 15    -> slot 4 := ('D.('var.4))   (re-dynamicised)
      *     read slot 4      -> AV2 = ('D.('var.4))
      *     ... both AVs delivered -> slot 4 consumed twice at run time
      *
      * AV1 went STALE the moment slot 4 was re-assigned: it still reads as "the
      * value of variable 4", but that is no longer the value it was created for.
      * The two AVs are equal as terms yet denote different run-time values.
      *
      * That is why no reordering helps, and why a capture is genuinely new
      * content: the AV language cannot express "the value slot k held at read
      * time".  The fix is to snapshot at read -- emit `Tmp <= ('var.k)` in
      * PAT-READ-LEAF-AV2 and return ('D.('var.Tmp)) -- so an AV names a value
      * that nothing can reassign.
      *
      * COST TO WEIGH BEFORE IMPLEMENTING.  Snapshotting at every dynamic var
      * read is sound but adds one residual command and one store slot per read,
      * enlarging EVERY residual -- against this project's own goal of getting
      * comp2/|spec_av| below 1.  Snapshotting only when a live AV would go stale
      * needs escape analysis over the AV store.  Choosing between them is a
      * design decision, not a mechanical fix.
      *
      * SNAPSHOT-ALWAYS WAS TRIED AND REJECTED (2026-08-07, measured).  It is
      * cheap to write -- RCode is already a global, so no threading is needed;
      * a TMP-ALLOC of three lines (copy the counter with `^=`, bump it with one
      * replacement) suffices, with the counter initialised and cleared in main.
      * Two things killed it:
      *
      *   1. RESIDUAL SIZE.  Every dynamic var read emits one capture:
      *        ri_min swap  115 ->  367   ri_min id   81 ->  333
      *        ri_seq rep   123 ->  375   ri_fp3 id2 1045 -> 1841
      *        ri_fp3 swap 1661 -> 4073
      *      2.5x to 4x, on every residual -- the opposite direction from
      *      comp2/|spec_av| < 1.
      *   2. IT STILL DOES NOT RUN.  The double-consume error does go away, so
      *      the diagnosis was right, but the residual is no longer store-clean:
      *      captured temps are stranded.  AV-LIFT turns ('D.('var.Tmp)) into an
      *      EXPRESSION, and an expression READS its variable without consuming
      *      it, so a lifted temp is never released.  Releasing it needs yet more
      *      residual commands.
      *
      * WHAT THAT LEAVES.  Snapshot-on-demand -- capture only when an outstanding
      * AV would go stale -- needs to REWRITE that outstanding AV from
      * ('D.('var.k)) to ('D.('var.Tmp)).  The AV representation cannot express
      * that: a dynamic AV refers to a slot by index, and the copies already
      * handed out (sitting on ri_fp3's stack, inside other AVs) are unreachable.
      * So this is not a matter of choosing a policy -- the representation has to
      * change first, e.g. so that a dynamic AV names a value cell that can be
      * re-pointed.  That is the real remaining work, and it is a redesign, not a
      * patch.
      *
      * RENAME-ON-WRITE WAS ALSO TRIED AND REJECTED (2026-08-07).  It looked like
      * the cheap way out: instead of rewriting outstanding references, let the
      * WRITER move.  When the 'ass path is about to re-dynamicise slot K whose
      * AV is ('S.nil) -- the marker PAT-READ leaves after handing the slot's
      * dynamic AV out -- give the new value a FRESH residual variable and point
      * the slot at that.  The outstanding reference keeps naming K, which still
      * holds what it was read for, and NO extra residual command is emitted.
      *
      * It does fix the inner conflict: `error in update: var=4` disappears.  But
      * it breaks ri_fp3's move idiom, which is a PAIR of assignments
      *
      *     A ^= B;  B ^= A          -- move B into A, B ends nil
      *
      * whose second command clears B only because A and B hold equal values at
      * run time.  The specializer sees the two assignments independently and
      * renames on each write, so the pair comes apart:
      *
      *     60 ^= 37;  37 ^= 60;     -- a proper move
      *     61 ^= 60;                -- no partner to clear 60: now BOTH hold it
      *     14 ^= 61;                -- copied again
      *     ... 14 ^= cons 5 6       -- error in update: var=14
      *
      * The AV domain cannot tell that two dynamic slots hold equal values, so it
      * cannot know that renaming one of them turns a clear into a set.  Any
      * scheme that moves where a dynamic value lives has to keep XOR-paired
      * assignments together, which again means the representation must record
      * the pairing -- back to the redesign.
      *
      * ===== CONSTRAINTS ANY SOLUTION MUST MEET =====
      * (derived from the two measured failures plus what the residual language
      * allows; write these down before trying a third design.)
      *
      * C1  NO ALIASES BETWEEN SLOTS.  A dynamic slot must stay self-referential
      *     ('D.('var.k)) for its own k.  Rename-on-write violated this and broke
      *     XOR-paired moves.  (The invariant is already documented at
      *     PAT-WRITE-LEAF-REHOME; the news is that ESCAPED references -- dynamic
      *     AVs sitting inside compound AVs, e.g. on ri_fp3's stack -- are not
      *     covered by it, and that is where the staleness enters.)
      * C2  A DYNAMIC REFERENCE MUST NOT OUTLIVE ITS SLOT'S NEXT ASSIGNMENT.
      *     Either capture the value before the slot is reused, or prove the
      *     reference is dead.  Capture-always satisfies this at 2.5-4x residual
      *     size; capture-on-escape (only when a dynamic AV is embedded in a
      *     compound by AV-CONS) would be cheaper and is UNTRIED.
      * C3  EVERY CAPTURED TEMP MUST BE CONSUMED.  A 'rep consumes its RHS
      *     pattern, so a temp delivered by PAT-WRITE-LEAF-REHOME is fine; but
      *     the 'ass path uses `K ^= lift(RE)`, and an EXPRESSION reads without
      *     consuming, so a temp that reaches an expression is stranded and the
      *     residual stops being store-clean.  This is what killed
      *     capture-always in practice.
      * C4  NO SELF-CLEARS IN THE RESIDUAL.  The obvious way to discharge C3 --
      *     emit `Tmp ^= Tmp` -- is not invertible (v -> nil and nil -> nil is not
      *     injective), and ri.rwhile already cannot reverse-interpret X^=X (see
      *     the KNOWN BUG test of that name).  So C3 has to be met by ROUTING the
      *     value out, not by erasing it.
      *
      * Two directions are open.  (a) Meet C1-C4 in the specializer: the likely
      * shape is capture-on-escape (C2) with the capture delivered through a 'rep
      * rather than an expression (C3, C4).  (b) Change the SUBJECT instead:
      * every non-transposing source already works, and the failure needs two
      * live references to ri_fp3's single working register -- giving its stack
      * machine two working slots would sidestep the whole thing.  (b) is much
      * cheaper and reaches the project's stated goal (fp1 via ri_fp3), but it
      * leaves the specializer's limitation in place.
      *
      * ===== (b) WAS DONE, 2026-08-08.  FLAT PATTERNS NOW WORK =====
      * Two changes to examples/ri_fp3.rwhile, both on the SUBJECT side; spec_av
      * is untouched.
      *
      *   1. A SECOND WORKING REGISTER in EVAL-PAT-STEP-FP3, selected by a unary
      *      counter Dp that mirrors the stack depth.  The two leaves of a flat
      *      cons pattern are pushed at different depths, so they stage through
      *      different slots and neither AV goes stale.  Dp is self-restoring
      *      ('rep runs EVAL-PAT then INV-EVAL-PAT, emptying St and Dp together)
      *      and static at specialization time, so the choice costs no residual.
      *   2. PAT-MOVE-FP3: the store moves became REPLACEMENTS (`X <= V[J]`)
      *      instead of the XOR pair `LOOKUP; UPDATE`.  This is what discharges
      *      C3.  The XOR pair residualizes as `V[J] ^= lift(AV)`, and lifting a
      *      COMPOUND AV makes an EXPRESSION, which reads its dynamic leaves
      *      without consuming them -- they are stranded and the residual stops
      *      being store-clean ("Some variables are not nil").  A replacement
      *      residualizes as a 'rep, whose RHS is a PATTERN, and a pattern read
      *      consumes.  C4 is met for free: nothing is erased, the value is
      *      ROUTED out.  Legal because the target of a pattern write is nil by
      *      R-WHILE's own semantics, and the working register is nil by
      *      construction.
      *
      * THE TRIGGER WAS NEVER TRANSPOSITION.  `sx_splitjoin` -- uncons then
      * rejoin in the SAME order, i.e. the identity -- failed identically.  What
      * it takes is TWO LEAVES IN ONE BUILT PATTERN.  The earlier note's "only
      * the two that exchange the halves of a cons fail" read the sample, not the
      * cause: those happened to be the only two-leaf sources tested.
      *
      * MEASURED (nodes in the fp1 residual, [spec_av]((ri_fp3.src))):
      *
      *     src            before   after
      *     id                835     649   -22%
      *     id2 / rep        1045     767   -27%
      *     id3              1117     847   -24%
      *     swap             1661    1071   -36%   (before: FAILED to run)
      *     sx_splitjoin     1661    1071   -36%   (before: FAILED to run)
      *
      * So the residuals got SMALLER as well as correct -- one 'rep in place of
      * two 'ass -- which is the direction comp2/|spec_av| < 1 needs.  ri_min's
      * fp1 numbers are untouched (103 / 63; it does not go through ri_fp3).
      *
      * THE REMAINING BOUND (open, pinned by TestSuite's
      * "fp1-via-ri_fp3 KNOWN BUG: nested pattern residual fails" and by
      * examples/sx_three.rwhile).  NESTED patterns still fail, and for a
      * SECOND, INDEPENDENT sharing: the 'consE step routes every split through
      * the same two slots V1e/V2e, so the compound AV built at one nesting level
      * goes stale when the next level reuses them.  The residual comes out
      * NON-LINEAR (`cons 5 (cons 5 nil)` -- the interpreter warns) and then
      * fails with a pattern write conflict.  ri_fp3 INTERPRETS sx_three
      * correctly; only the residual is broken.
      *
      * Multiplying V1e/V2e the same way only moves the bound: k register pairs
      * cover nesting depth k, because the number of simultaneously live values
      * is unbounded in the pattern.
      *
      * ===== (a) CAPTURE-ON-ESCAPE: SHIPPED 2026-08-08.  THE BOUND IS GONE =====
      * (History: it was first measured on its own and looked like a 13x cost
      * regression -- see the numbers below.  Copy propagation over the residual
      * turned that around completely, so it is now ON by default.  The
      * intermediate numbers are kept because they explain WHY the second pass is
      * needed, and because a future change that breaks copyprop would show up as
      * a return to them.)
      *
      * It WORKS, and it is the first design that removes the nesting bound.
      * Shape: a real temp allocator (TMP-ALLOC: a global counter TmpCtr started
      * at 100 in main, one nil added per allocation) plus AV-CAPTURE(A, RCode),
      * called on both components in PAT-READ-ITER-STEP's 'consE arm -- exactly
      * where a dynamic AV escapes into a compound.  When A is a bare
      * ('D.('var.k)) it emits `Tmp <= ('var.k)` and returns ('D.('var.Tmp)).
      *
      * The C3/C4 half is settled: emitting the capture as a 'rep rather than an
      * 'ass is what makes it work.  A 'rep's RHS is a PATTERN, so it CONSUMES
      * slot k -- the value moves, the slot is freed, and the temp is consumed in
      * turn by the pattern write that delivers the compound.  Nothing is erased,
      * so no self-clear is needed.  This is the same insight as PAT-MOVE-FP3
      * above.  Capture-always failed on C3 precisely because it delivered
      * through AV-LIFT, i.e. through an expression.
      *
      * MEASURED: sx_three -- the nested pattern that pins the current bound --
      * specializes into a residual that RUNS and returns ('b.('a.nil)), correct.
      * The flat cases stay correct too.  So the bound is genuinely gone.
      *
      * THE COST, BEFORE THE SECOND PASS, looked fatal -- worse than
      * capture-always:
      *
      *     fp1 residual [spec_av]((ri_min.swap))   103 -> 2131 nodes
      *                                         0.63x -> 13.07x |ri_min|
      *     fp1 residual [spec_av]((ri_min.id))      63 -> 1075
      *     via ri_fp3: id    649 -> 1661     swap  1071 -> 8239   (7.7x)
      *
      * A residual THIRTEEN TIMES the interpreter is not a specialization at all.
      * The cause: PAT-READ-ITER's 'consE fires for every cons in every pattern
      * read the specializer performs, and captures unconditionally -- so the
      * overwhelming majority of the emitted moves are for slots that are never
      * reused, and are pure overhead.
      *
      * ===== THE SECOND PASS: COPY PROPAGATION OVER THE RESIDUAL =====
      * "Capture only when the reference would go stale" was thought to need
      * escape analysis over the AV store, which the representation cannot
      * support.  It does not.  Capture UNCONDITIONALLY -- sound and bound-free,
      * as above -- and delete the redundant captures AFTERWARDS: a `Tmp <=
      * ('var.k)` where Tmp is written once and read once and k is untouched in
      * between is plain COPY PROPAGATION, and the residual is ordinary R-WHILE,
      * so it is a standard analysis over a small program rather than an
      * intractable one over annotated values.  Implemented as
      * Simp.copyprop_program (src/Simp.ml; conditions and their justification are
      * documented there, tests in the `simp-copyprop` group).
      *
      * MEASURED END TO END (./measure_proj, ./fp3probe):
      *
      *                        before capture   capture   capture + copyprop
      *     fp1 (ri_min.swap)    103  (0.63x)      2131         59  (0.36x)
      *     fp1 (ri_min.id)       63               1075         53
      *     via ri_fp3  swap    1071               8239        379
      *     via ri_fp3  id       649               1661         53
      *     via ri_fp3  sx_three  FAILED          10495        543
      *
      * 0.36x beats the previous default (0.63x), the best of all 120 variable
      * permutations (83 nodes), and pass 3 (87).  [Bcp](('a.'b)) = ('swap.('b.'a))
      * and [inv Bcp] round-trips.  So the capture pays for itself and then some:
      * copyprop fuses not only the redundant captures but also the move chains
      * ri_fp3's stack machine emitted all along.
      *
      * Two consequences for anyone editing this file:
      *   - the fp1 TEST HARNESSES (parse_macro_harness in TestSuite.ml) build
      *     their own main, so they must bracket the body with TEMP-IDX(TmpCtr)
      *     and a clear -- injected once in that helper -- else the store-clean
      *     check trips on the counter alone and looks like a specialiser bug;
      *   - examples/spec_av_clean.rwhile must be kept in step (refactor-gate). *)
     PAT-WRITE-ITER(RpQ, RpAV, RCode);
     Arg <= cons RpQ RpR
   else
    if =? Tag 'cond then
      cons E (cons C (cons D (cons F nil))) <= Arg;   (* Arg -> E,C,D,F *)
      SPEC-EXP-AV(E, RE);                              (* E preserved; RE = test AV *)
      cons TT VT <= RE;
      AnnT ^= =? TT 'S;
      if AnnT then
        (* static test: VT is the boolean; take one branch, drop the other *)
        CVT ^= VT;
        if VT then
          Cd <= cons C Cd;
          D ^= D
        else
          Cd <= cons D Cd;
          C ^= C
        fi CVT;
        CVT ^= CVT;
        VT ^= VT; TT ^= 'S;
        E ^= E; F ^= F
      else
        (* dynamic test: residualize the whole conditional with lifted test.
         * The branches may read/modify any variable, so first DYNAMICIZE the
         * store (materialise static slots, mark all dynamic) — this runs
         * BEFORE the residual cond (prepend it first), so the residual sees the
         * correct runtime values and no stale static value leaks past. *)
        RE <= cons TT VT;
        AV-LIFT(RE, LE);
        RE ^= RE;
        E ^= E;
        DYNAMICIZE-ALL(Vl, RCode);
        Arg <= cons LE (cons C (cons D (cons F nil)));
        Ccond ^= Arg;
        RCode <= cons (cons 'cond Ccond) RCode;
        Arg ^= Arg
      fi AnnT;
      AnnT ^= AnnT
    else
     if =? Tag 'loop then
       (* loop = ('loop . (E . (D . (L . (F . nil))))).  Static control unrolls
        * SPECULATIVELY via an 'lcheck continuation; dynamic control
        * residualizes the loop.
        *
        * ===== SPECULATIVE UNROLLING (2026-08-09) =====
        * Whether unrolling is legal cannot be decided here.  A loop is
        * unrollable only if BOTH its tests stay static, and the exit test F is
        * first evaluated one body-run LATER (in 'lcheck) -- by which time the
        * body may have dynamicized the store (`examples/reverse.rwhile`: `=? Y
        * nil` is static-false while Y is the partial-static input cons, and
        * dynamic once the static head has been consumed).  This is a
        * binding-time FIXPOINT and it cannot be read off the loop entry; the
        * previous code simply died there (`'error <= '41`).
        *
        * So: unroll on speculation, and keep what is needed to undo it.  The
        * CHECKPOINT below is the specializer state that the speculation will
        * dirty -- the abstract store Vl, the residual code RCode and the
        * fresh-temp counter TmpCtr -- copied into the 'lcheck continuation.
        * (The work stack Cd needs no checkpoint: unrolling pushes D and the
        * frame onto it and specializing D is stack-balanced, so by the time
        * 'lcheck is popped Cd is already back to its entry value.)  'lcheck
        * either carries the checkpoint forward (another iteration), drops it
        * (the loop finished statically) or RESTORES it -- see there.
        *
        * Why the undo has to reach all the way back to the loop ENTRY, rather
        * than keeping the k iterations already unrolled and residualizing the
        * rest: a REVERSIBLE loop asserts its entry test TRUE on first entry and
        * FALSE on every loop-back, so it cannot be re-entered half way through.
        * There is no residual loop that means "carry on from iteration k".
        * Cf. proofs/agda/RWhileLoopBTA*.agda (`exit-dynamic-forces-residual`).
        *
        * Copying the checkpoint is what a reversible language makes cheap:
        * `^=` reads its right-hand side as an EXPRESSION, so it duplicates
        * without consuming, and the pre-state can be carried on the stack
        * rather than reconstructed.  Running the specializer BACKWARDS instead
        * (INV-SPEC-STEP-AV over the Cd' history) does NOT work here and the
        * reason is worth recording: spec_av is not injective.  It drops
        * garbage with the `X ^= X` idiom -- e.g. this very handler ends
        * `LpE ^= LpE; LpD ^= LpD; ...` -- and the inverse of `X ^= X` maps nil
        * to nil, so inverting one 'lcheck step reconstructs its Arg as
        * (nil.(nil.(nil.(nil.nil)))) and leaves LpEc..LpFc dirty.  Reverse
        * execution would be exact in spec_av_rev.rwhile, which embeds its
        * garbage; here the checkpoint IS that embedding, taken only where it
        * is needed.  See FINDINGS_reversible_projections.md section 10. *)
       cons LpE (cons LpD (cons LpL (cons LpF nil))) <= Arg;
       SPEC-EXP-AV(LpE, LpRE);
       cons LpTE LpVE <= LpRE;
       LpCEs ^= =? LpTE 'S;
       if LpCEs then
         if LpVE then
           (* static entry true: CHECKPOINT, then run D and check exit via
            * 'lcheck.  Frame: ('lcheck.(E.(D.(L.(F.(Vl.(RCode.(TmpCtr.nil))))))))
            * -- SpcVl/SpcRc/SpcTc are copies and the frame consumes them. *)
           LpEc ^= LpE; LpDc ^= LpD; LpLc ^= LpL; LpFc ^= LpF;
           LpDp ^= LpD;
           SpcVl ^= Vl; SpcRc ^= RCode; SpcTc ^= TmpCtr;
           Cd <= cons LpDp (cons (cons 'lcheck (cons LpEc (cons LpDc (cons LpLc (cons LpFc (cons SpcVl (cons SpcRc (cons SpcTc nil)))))))) Cd);
           LpE ^= LpE; LpD ^= LpD; LpL ^= LpL; LpF ^= LpF
         else
           'error <= '40
         fi LpVE;
         LpVE ^= LpVE;
         LpTE ^= 'S
       else
         (* dynamic entry test: residualize whole loop (entry test lifted).
          * The body may modify any var, so DYNAMICIZE the store first (runs
          * before the residual loop), keeping the abstract store consistent. *)
         LpRE <= cons LpTE LpVE;
         AV-LIFT(LpRE, LpLEe);
         LpRE ^= LpRE;
         LpE ^= LpE;
         DYNAMICIZE-ALL(Vl, RCode);
         Arg <= cons LpLEe (cons LpD (cons LpL (cons LpF nil)));
         LpCl ^= Arg;
         RCode <= cons (cons 'loop LpCl) RCode;
         Arg ^= Arg
       fi LpCEs;
       LpCEs ^= LpCEs
     else
      if =? Tag 'lcheck then
        (* The continuation left by a SPECULATIVE unroll; it carries the
         * checkpoint taken at the loop's entry (see the 'loop handler). *)
        cons LpE (cons LpD (cons LpL (cons LpF (cons SpcVl (cons SpcRc (cons SpcTc nil)))))) <= Arg;
        SPEC-EXP-AV(LpF, LpRF);
        cons LpTF LpVF <= LpRF;
        LpCFs ^= =? LpTF 'S;
        if LpCFs then
          if LpVF then
            (* exit test true: loop finished, the speculation paid off and the
             * checkpoint is dead -- drop it. *)
            SpcVl ^= SpcVl; SpcRc ^= SpcRc; SpcTc ^= SpcTc;
            LpE ^= LpE; LpD ^= LpD; LpL ^= LpL; LpF ^= LpF
          else
            (* exit test false: run L, then D, then re-check via 'lcheck.  The
             * checkpoint is carried into the new frame unchanged (still the
             * state at the loop's ENTRY, not at this iteration). *)
            LpEc ^= LpE; LpDc ^= LpD; LpLc ^= LpL; LpFc ^= LpF;
            LpLp ^= LpL; LpDp ^= LpD;
            Cd <= cons LpLp (cons LpDp (cons (cons 'lcheck (cons LpEc (cons LpDc (cons LpLc (cons LpFc (cons SpcVl (cons SpcRc (cons SpcTc nil)))))))) Cd));
            LpE ^= LpE; LpD ^= LpD; LpL ^= LpL; LpF ^= LpF
          fi LpVF;
          LpVF ^= LpVF;
          LpTF ^= 'S
        else
          (* ===== THE SPECULATION FAILED (this used to be `'error <= '41`) ====
           * The exit test stopped being static while the loop was being
           * unrolled.  Everything done since the loop was entered is worthless
           * -- ROLL BACK to the checkpoint and residualize the loop from its
           * entry instead.  The rollback is three restores, because the
           * checkpoint holds exactly the state the speculation could dirty:
           * the abstract store, the residual code emitted for the discarded
           * iterations, and the fresh-temp counter (restored so the residual
           * does not depend on how far the speculation got). *)
          LpTF ^= LpTF; LpVF ^= LpVF;               (* drop the dynamic exit AV *)
          Vl ^= Vl;         Vl ^= SpcVl;      SpcVl ^= SpcVl;
          RCode ^= RCode;   RCode ^= SpcRc;   SpcRc ^= SpcRc;
          TmpCtr ^= TmpCtr; TmpCtr ^= SpcTc;  SpcTc ^= SpcTc;
          (* Now residualize, in the order the residual must RUN: materialise
           * the store first, and only then re-specialize the ENTRY test in the
           * dynamicized store.  Re-specializing is the point: the entry test
           * was static-true at this program point, and emitting it as the
           * constant true would give a loop that can never take its back edge
           * -- a non-iterable, hence non-reversible, residual.  Cf.
           * proofs/agda/RWhileLoopBTA*.agda (`constEntry-no-iter`). *)
          DYNAMICIZE-ALL(Vl, RCode);
          SPEC-EXP-AV(LpE, LpRE);
          AV-LIFT(LpRE, LpLEe);
          LpRE ^= LpRE;
          LpE ^= LpE;
          Arg <= cons LpLEe (cons LpD (cons LpL (cons LpF nil)));
          LpCl ^= Arg;
          RCode <= cons (cons 'loop LpCl) RCode;
          Arg ^= Arg
        fi LpCFs;
        LpCFs ^= LpCFs
      else
       if =? Tag 'seq then
         (* push both subcommands onto the work stack; the shell is discarded,
          * so no seqB/seqE reconstruction is needed (and cond/loop nested in a
          * seq do not corrupt a shell stack). *)
         cons C D <= Arg;
         Cd <= cons C (cons D Cd)
       else
         'error <= '1
       fi =? Tag 'seq
      fi =? Tag 'lcheck
     fi =? Tag 'loop
    fi =? Tag 'cond
   fi =? Tag 'rep
  fi =? Tag 'ass;
  Cd' <= cons (cons Tag Arg) Cd'

(* SPEC-CMD-AV(Cmd): run SPEC-STEP-AV over Cmd; the residual program accumulates
 * in RCode (reverse order).  Cmd is consumed into the work stack; the shell
 * (Cd') is discarded (we do not reconstruct the source command — the residual is
 * what matters).  Note: injectivity embedding of the source is a Stage-C concern. *)
macro SPEC-CMD-AV(Cmd)
  Cd <= cons Cmd nil;
  from (=? Cd' nil) loop
    SPEC-STEP-AV(Cd, Cd', RCode)
  until (=? Cd nil);
  Cd' ^= Cd'

(* MKAV(BT, Src, Ic, AVout): build the partial-input AV for the read variable,
 * BINDING-TIME-AWARE (the fp2 fix; mirrors RWhileRevProj2BT.agda `mkAV`).
 *   BT = 'S (static input half):  AVout = ('C.(('S.Src).('D.('var.Ic))))
 *        car static (folded), cdr dynamic (the other input half) -- as in fp1.
 *   BT = 'D (dynamic input half): AVout = ('D.('var.Ic))
 *        the whole input variable is dynamic; Src carries no static info.
 * Consumes BT, Src, Ic.  Under self-application (fp2) BT is itself dynamic, so
 * the OUTER specializer RESIDUALIZES this branch instead of statically baking
 * 'S -- exactly the two-level discipline that makes spec_av self-applicable
 * (the unconditional 'S tag was the fp2 root cause; see RWhileRevProj2BT). *)
macro MKAV(BT, Src, Ic, AVout)
  MkS ^= =? BT 'S;
  if MkS then
    BT ^= 'S;
    AVout <= cons 'C (cons (cons 'S Src) (cons 'D (cons 'var Ic)))
  else
    BT ^= 'D;
    Src ^= Src;
    AVout <= cons 'D (cons 'var Ic)
  fi MkS;
  MkS ^= MkS

(* ===== Main program ===== *)
(* First Futamura projection (fp1), now BINDING-TIME-AWARE (self-applicable).
 * Input  In = (Prog . (BT . Src)), Prog = p2d of the program to specialise
 *   (= (('var.I') . (Body . ('var.J')))), Src = the static input half, and BT
 *   = its binding time ('S static / 'D dynamic).  fp1 uses BT='S; under self-
 *   application (fp2) the inner specialiser's (BT.Src) is dynamic, so MKAV's
 *   branch on BT residualises rather than baking 'S (the fp2 root cause fix;
 *   cf. RWhileRevProj2BT.agda).
 * Output Out = comp_src, the residual program specialised to Src, with the
 *   other input half left dynamic: [comp_src](d) = [Prog]((Src.d)) when BT='S.
 * Method: init an N-slot static-nil AV store, set V[I'] to the partial input
 *   AV = MKAV(BT,Src,I') (BT='S -> ('C.(('S.Src).('D.('var.I'))))), specialise
 *   Body, and assemble. N is fixed (3 for now; raise for ri_fp3). *)

read In;
  cons Prog FpBTS <= In;
  cons FpBT Src <= FpBTS;
  (* decode Prog = (('var.I') . (Body . ('var.J'))) *)
  cons FpPR FpPT <= Prog;
  cons FpVI FpI <= FpPR;  FpVI ^= 'var;
  cons FpBody FpPW <= FpPT;
  cons FpVJ FpJ <= FpPW;  FpVJ ^= 'var;

  (* init static-nil AV store (N = 3) *)
  FpN ^= (nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.nil))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))));
  AV-INIT(FpN, Vl);
  FpN ^= (nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.(nil.nil))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))));

  (* set V[I'] = MKAV(BT, Src, I'): BT='S -> ('C.(('S.Src).('D.('var.I')))),
     BT='D -> ('D.('var.I')).  Binding-time-aware so fp2 residualises the tag. *)
  LOOKUP(Vl, FpI, FpOld);  UPDATE(Vl, FpI, FpOld);  FpOld ^= FpOld;
  FpIc ^= FpI;
  MKAV(FpBT, Src, FpIc, FpPart);
  UPDATE(Vl, FpI, FpPart);
  FpPart ^= FpPart;

  (* fresh-temp counter for AV-CAPTURE: start above every program variable index *)
  TEMP-IDX(TmpCtr);

  (* specialise the body, assemble the residual *)
  SPEC-CMD-AV(FpBody);
  ASSEMBLE-FP1(FpI, FpJ, Out);
  RCode ^= RCode;
  TmpCtr ^= TmpCtr;
  Vl ^= Vl;
  FpI ^= FpI;
  FpJ ^= FpJ;
write Out
