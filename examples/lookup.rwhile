(* Hygiene-clean: the accumulator scratch (Rev, Cnt) is threaded through
   parameters so AUX and INV-AUX coincide on it under -hygienic-macros.
   U is a true per-iteration local. *)
macro LOOKUP(Vl,J,X)
  AUX(Vl,J,X,T,Rev,Cnt);
  X ^= T;
  INV-AUX(Vl,J,X,T,Rev,Cnt)   (* clear T *)

macro UPDATE(Vl,J,X)
  AUX(Vl,J,X,T,Rev,Cnt);
  T ^= X;
  INV-AUX(Vl,J,X,T,Rev,Cnt)   (* clear T *)

macro AUX(Vl,J,X,T,Rev,Cnt)
  from (=? Cnt nil) loop
    cons U Vl <= Vl;
    Rev <= cons U Rev;
    Cnt <= cons nil Cnt  (* Cnt := Cnt + 1 *)
  until (=? Cnt J);
  cons T Vl <= Vl

read X;
  Vl ^= ('00.('11.('22.nil)));
  J ^= (nil.(nil.nil));
  LOOKUP(Vl,J,X);
  J ^= (nil.(nil.nil));
  Vl ^= ('00.('11.('22.nil)));
write X